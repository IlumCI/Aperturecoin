+// Copyright (c) 2026 The ApertureCoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// C ABI over ApertureCoin's ApertureMatMul v2 consensus code for the Rust SRI
+// roles. The forward-pass batching rule (every request + EOS, in order; an
+// empty batch runs EOS only; traces concatenated per op) is the one
+// aperture-sv2-miner uses (contrib/sv2-tp), so pool and miner agree on every
+// activation row.
+
+#include <crypto/matmulpow_v2.h>
+#include <crypto/matmulpow_v2_kernel.h>
+#include <model/apm.h>
+#include <model/intmodel.h>
+
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace {
+
+void SetError(char* err, size_t len, const std::string& msg)
+{
+    if (!err || len == 0) return;
+    const size_t n = std::min(len - 1, msg.size());
+    memcpy(err, msg.data(), n);
+    err[n] = 0;
+}
+
+struct Model {
+    intmodel::IntModel model;
+};
+
+struct Work {
+    const Model* model{nullptr};
+    unsigned int rank{0};
+    std::vector<intmodel::OpTrace> trace;
+    std::vector<matmulpow_v2::OpInput> inputs;
+};
+
+Model* Init(std::unique_ptr<apm::Model> apm_model, char* err, size_t errlen)
+{
+    auto m = std::make_unique<Model>();
+    std::string error;
+    if (!m->model.Init(std::move(apm_model), error)) {
+        SetError(err, errlen, error);
+        return nullptr;
+    }
+    return m.release();
+}
+
+} // namespace
+
+extern "C" {
+
+void* apw_model_load_file(const char* path, char* err, size_t errlen)
+{
+    auto apm_model = std::make_unique<apm::Model>();
+    std::string error;
+    if (!apm_model->LoadFile(path, error)) {
+        SetError(err, errlen, error);
+        return nullptr;
+    }
+    return Init(std::move(apm_model), err, errlen);
+}
+
+void* apw_model_tiny(uint32_t seed, char* err, size_t errlen)
+{
+    auto apm_model = std::make_unique<apm::Model>();
+    std::string error;
+    if (!apm_model->Load(intmodel::BuildTinyModel(seed), error)) {
+        SetError(err, errlen, error);
+        return nullptr;
+    }
+    return Init(std::move(apm_model), err, errlen);
+}
+
+void apw_model_free(void* m) { delete static_cast<Model*>(m); }
+
+/** model_id as the 64-character hex string the node reports. */
+void apw_model_id_hex(const void* m, char out[65])
+{
+    const std::string& hex = static_cast<const Model*>(m)->model.Apm().ModelIdHex();
+    memset(out, 0, 65);
+    memcpy(out, hex.data(), std::min<size_t>(64, hex.size()));
+}
+
+uint32_t apw_model_num_ops(const void* m) { return static_cast<const Model*>(m)->model.Ops().size(); }
+
+/**
+ * Forward pass over a batch: ids is every request's token ids back to back,
+ * lens[k] the length of request k. Returns null on an invalid request.
+ */
+void* apw_work_new(const void* mp, const uint32_t* ids, const uint32_t* lens, size_t n_requests, uint32_t rank, char* err, size_t errlen)
+{
+    const Model* m = static_cast<const Model*>(mp);
+    if (rank == 0 || rank > 64) {
+        SetError(err, errlen, "invalid rank");
+        return nullptr;
+    }
+    auto w = std::make_unique<Work>();
+    w->model = m;
+    w->rank = rank;
+    std::vector<std::vector<uint32_t>> batch;
+    size_t off = 0;
+    for (size_t k = 0; k < n_requests; ++k) {
+        batch.emplace_back(ids + off, ids + off + lens[k]);
+        off += lens[k];
+    }
+    if (batch.empty()) batch.emplace_back();
+    for (auto& input : batch) {
+        input.push_back(m->model.Config().eos_token_id);
+        std::vector<intmodel::OpTrace> part;
+        if (m->model.Embed(input, &part).empty()) {
+            SetError(err, errlen, "request cannot be embedded");
+            return nullptr;
+        }
+        if (w->trace.empty()) {
+            w->trace = std::move(part);
+            continue;
+        }
+        for (size_t k = 0; k < w->trace.size(); ++k) {
+            w->trace[k].q.insert(w->trace[k].q.end(), part[k].q.begin(), part[k].q.end());
+            w->trace[k].rows += part[k].rows;
+        }
+    }
+    for (const auto& tr : w->trace) w->inputs.push_back(matmulpow_v2::OpInput{tr.op, tr.rows, tr.q.data()});
+    return w.release();
+}
+
+void apw_work_free(void* w) { delete static_cast<Work*>(w); }
+
+uint32_t apw_work_rows(const void* wp, uint16_t op)
+{
+    const Work* w = static_cast<const Work*>(wp);
+    for (const auto& tr : w->trace) {
+        if (tr.op == op) return tr.rows;
+    }
+    return 0;
+}
+
+/**
+ * The honest r x r activation panel A[rows i][K-block s] of op (rows past the
+ * end zero-padded), as the miner's kernels read it. Returns 0 if out of range.
+ */
+int apw_work_panel(const void* wp, uint16_t op, uint16_t i, uint16_t s, int8_t* out)
+{
+    const Work* w = static_cast<const Work*>(wp);
+    const unsigned int r = w->rank;
+    for (const auto& tr : w->trace) {
+        if (tr.op != op) continue;
+        if ((static_cast<uint64_t>(s) + 1) * r > tr.d_in) return 0;
+        if (static_cast<uint64_t>(i) * r >= (static_cast<uint64_t>(tr.rows) + r - 1) / r * r) return 0;
+        memset(out, 0, static_cast<size_t>(r) * r);
+        for (unsigned int x = 0; x < r; ++x) {
+            const uint64_t row = static_cast<uint64_t>(i) * r + x;
+            if (row < tr.rows) memcpy(out + x * r, tr.q.data() + row * tr.d_in + static_cast<size_t>(s) * r, r);
+        }
+        return 1;
+    }
+    return 0;
+}
+
+/**
+ * Search every ticket of one nonce (sigma) for pow <= target (little endian).
+ * Returns 1 and the lowest-numbered winning ticket, 0 if none. tickets
+ * receives the number of tickets evaluated.
+ */
+int apw_work_search(const void* wp, const unsigned char sigma[32], const unsigned char target_le[32], uint16_t ticket_out[4],
+                    int8_t* panel_out, unsigned char pow_out[32], uint64_t* tickets)
+{
+    const Work* w = static_cast<const Work*>(wp);
+    matmulpow_v2::SearchHit hit;
+    uint64_t n{0};
+    const bool found = matmulpow_v2::SearchNonce(matmulpow_v2::BestBackend(), sigma, w->rank, w->model->model.Ops(), w->inputs, target_le, hit, n);
+    if (tickets) *tickets = n;
+    if (!found) return 0;
+    ticket_out[0] = hit.ticket.op;
+    ticket_out[1] = hit.ticket.i;
+    ticket_out[2] = hit.ticket.j;
+    ticket_out[3] = hit.ticket.s;
+    memcpy(panel_out, hit.panel.data(), static_cast<size_t>(w->rank) * w->rank);
+    memcpy(pow_out, hit.pow, 32);
+    return 1;
+}
+
+/** sigma = BLAKE3("ApertureMatMul/v2/seed" || header80 || batch_root). */
+void apw_seed(const unsigned char header80[80], const unsigned char batch_root[32], unsigned char sigma[32])
+{
+    unsigned char buf[112];
+    memcpy(buf, header80, 80);
+    memcpy(buf + 80, batch_root, 32);
+    matmulpow_v2::Seed(buf, sizeof(buf), sigma);
+}
+
+/** Consensus ticket hash (what a node computes from the header). 0 if out of range. */
+int apw_ticket_pow(const void* mp, uint32_t rank, const unsigned char sigma[32], const uint16_t ticket[4], const int8_t* panel,
+                   size_t panel_len, unsigned char pow_out[32])
+{
+    const Model* m = static_cast<const Model*>(mp);
+    const auto& ops = m->model.Ops();
+    if (rank == 0 || panel_len != static_cast<size_t>(rank) * rank || ticket[0] >= ops.size()) return 0;
+    matmulpow_v2::Ticket t;
+    t.op = ticket[0];
+    t.i = ticket[1];
+    t.j = ticket[2];
+    t.s = ticket[3];
+    return matmulpow_v2::TicketPoW(sigma, rank, ops[t.op], t, panel, pow_out) ? 1 : 0;
+}
+
+const char* apw_backend_name() { return matmulpow_v2::BackendName(matmulpow_v2::BestBackend()); }
+
+} // extern "C"
diff --git a/aperture/aperture-pouw/src/lib.rs b/aperture/aperture-pouw/src/lib.rs
new file mode 100644
index 00000000..d7f16842
--- /dev/null
+++ b/aperture/aperture-pouw/src/lib.rs
@@ -0,0 +1,326 @@
+//! ApertureMatMul v2 (proof of useful work, ApertureCoin `doc/pouw-v2.md`) for
+//! the SRI stack.
+//!
+//! These are bindings to the node's own consensus C++ (`src/crypto/matmulpow_v2*`,
+//! `src/model/{apm,intmodel}.cpp`), compiled from `APERTURE_SRC`, so the pool
+//! verifies and the miner searches exactly what a node checks:
+//!
+//! - [`Model`]: the protocol model (`.apm` file, or the regtest tiny model).
+//! - [`Work`]: one template's forward pass over its embedding requests. It gives
+//!   the int8 activations every ticket is taken from.
+//! - [`seed`], [`Model::ticket_pow`]: the header-level ticket check.
+//! - [`Work::search`]: all r×r×r tickets of one nonce, vectorized kernels.
+//!
+//! Wire formats of the pooled useful-work extension are in [`wire`].
+
+use std::{
+    ffi::{c_char, c_void, CStr, CString},
+    sync::Arc,
+};
+
+pub mod wire;
+
+extern "C" {
+    fn apw_model_load_file(path: *const c_char, err: *mut c_char, errlen: usize) -> *mut c_void;
+    fn apw_model_tiny(seed: u32, err: *mut c_char, errlen: usize) -> *mut c_void;
+    fn apw_model_free(m: *mut c_void);
+    fn apw_model_id_hex(m: *const c_void, out: *mut c_char);
+    fn apw_model_num_ops(m: *const c_void) -> u32;
+    fn apw_work_new(
+        m: *const c_void,
+        ids: *const u32,
+        lens: *const u32,
+        n: usize,
+        rank: u32,
+        err: *mut c_char,
+        errlen: usize,
+    ) -> *mut c_void;
+    fn apw_work_free(w: *mut c_void);
+    fn apw_work_rows(w: *const c_void, op: u16) -> u32;
+    fn apw_work_panel(w: *const c_void, op: u16, i: u16, s: u16, out: *mut i8) -> i32;
+    fn apw_work_search(
+        w: *const c_void,
+        sigma: *const u8,
+        target_le: *const u8,
+        ticket: *mut u16,
+        panel: *mut i8,
+        pow: *mut u8,
+        tickets: *mut u64,
+    ) -> i32;
+    fn apw_seed(header80: *const u8, batch_root: *const u8, sigma: *mut u8);
+    fn apw_ticket_pow(
+        m: *const c_void,
+        rank: u32,
+        sigma: *const u8,
+        ticket: *const u16,
+        panel: *const i8,
+        panel_len: usize,
+        pow: *mut u8,
+    ) -> i32;
+    fn apw_backend_name() -> *const c_char;
+}
+
+fn err_buf() -> Vec<u8> {
+    vec![0u8; 256]
+}
+
+fn err_string(buf: &[u8]) -> String {
+    CStr::from_bytes_until_nul(buf)
+        .map(|c| c.to_string_lossy().into_owned())
+        .unwrap_or_default()
+}
+
+/// A ticket: row tile `i`, column tile `j` and K-block `s` of weight matmul `op`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct Ticket {
+    pub op: u16,
+    pub i: u16,
+    pub j: u16,
+    pub s: u16,
+}
+
+/// The protocol model. Immutable once loaded; share it with `Arc`.
+pub struct Model {
+    ptr: *mut c_void,
+    model_id: [u8; 32],
+}
+
+// The C++ model is immutable after Init and only read concurrently.
+unsafe impl Send for Model {}
+unsafe impl Sync for Model {}
+
+impl Model {
+    fn from_ptr(ptr: *mut c_void, err: &[u8]) -> Result<Arc<Self>, String> {
+        if ptr.is_null() {
+            return Err(err_string(err));
+        }
+        let mut hex = [0 as c_char; 65];
+        unsafe { apw_model_id_hex(ptr, hex.as_mut_ptr()) };
+        let hex = unsafe { CStr::from_ptr(hex.as_ptr()) }
+            .to_string_lossy()
+            .into_owned();
+        let mut model_id = [0u8; 32];
+        for (k, b) in model_id.iter_mut().enumerate() {
+            *b = u8::from_str_radix(&hex[2 * k..2 * k + 2], 16).map_err(|e| e.to_string())?;
+        }
+        Ok(Arc::new(Model { ptr, model_id }))
+    }
+
+    /// Load an `.apm` model file.
+    pub fn load_file(path: &str) -> Result<Arc<Self>, String> {
+        let c = CString::new(path).map_err(|e| e.to_string())?;
+        let mut err = err_buf();
+        let ptr =
+            unsafe { apw_model_load_file(c.as_ptr(), err.as_mut_ptr() as *mut c_char, err.len()) };
+        Self::from_ptr(ptr, &err)
+    }
+
+    /// The deterministic regtest model (`-tinymodel`, seed 1 on regtest).
+    pub fn tiny(seed: u32) -> Result<Arc<Self>, String> {
+        let mut err = err_buf();
+        let ptr = unsafe { apw_model_tiny(seed, err.as_mut_ptr() as *mut c_char, err.len()) };
+        Self::from_ptr(ptr, &err)
+    }
+
+    /// model_id in the byte order the node displays (and the TP sends).
+    pub fn model_id(&self) -> [u8; 32] {
+        self.model_id
+    }
+
+    pub fn num_ops(&self) -> u32 {
+        unsafe { apw_model_num_ops(self.ptr) }
+    }
+
+    /// Consensus ticket hash of `panel` under `sigma`; `None` if the ticket or
+    /// panel is out of range (a node rejects such a header).
+    pub fn ticket_pow(
+        &self,
+        rank: u32,
+        sigma: &[u8; 32],
+        t: Ticket,
+        panel: &[i8],
+    ) -> Option<[u8; 32]> {
+        let ticket = [t.op, t.i, t.j, t.s];
+        let mut pow = [0u8; 32];
+        let ok = unsafe {
+            apw_ticket_pow(
+                self.ptr,
+                rank,
+                sigma.as_ptr(),
+                ticket.as_ptr(),
+                panel.as_ptr(),
+                panel.len(),
+                pow.as_mut_ptr(),
+            )
+        };
+        (ok == 1).then_some(pow)
+    }
+}
+
+impl Drop for Model {
+    fn drop(&mut self) {
+        unsafe { apw_model_free(self.ptr) }
+    }
+}
+
+/// One template's forward pass (the useful work) and its ticket operands.
+pub struct Work {
+    ptr: *mut c_void,
+    model: Arc<Model>,
+    rank: u32,
+}
+
+unsafe impl Send for Work {}
+unsafe impl Sync for Work {}
+
+/// A winning ticket of one nonce.
+#[derive(Clone, Debug)]
+pub struct Hit {
+    pub ticket: Ticket,
+    pub panel: Vec<i8>,
+    pub pow: [u8; 32],
+}
+
+impl Work {
+    /// Run the protocol model over `requests` (token ids without EOS).
+    pub fn new(model: Arc<Model>, requests: &[Vec<u32>], rank: u32) -> Result<Arc<Self>, String> {
+        let ids: Vec<u32> = requests.iter().flatten().copied().collect();
+        let lens: Vec<u32> = requests.iter().map(|r| r.len() as u32).collect();
+        let mut err = err_buf();
+        let ptr = unsafe {
+            apw_work_new(
+                model.ptr,
+                ids.as_ptr(),
+                lens.as_ptr(),
+                lens.len(),
+                rank,
+                err.as_mut_ptr() as *mut c_char,
+                err.len(),
+            )
+        };
+        if ptr.is_null() {
+            return Err(err_string(&err));
+        }
+        Ok(Arc::new(Work { ptr, model, rank }))
+    }
+
+    pub fn rank(&self) -> u32 {
+        self.rank
+    }
+
+    pub fn model(&self) -> &Arc<Model> {
+        &self.model
+    }
+
+    /// Activation rows of weight matmul `op` (0 if the op is unknown).
+    pub fn rows(&self, op: u16) -> u32 {
+        unsafe { apw_work_rows(self.ptr, op) }
+    }
+
+    /// The honest activation panel of a ticket (what the miner must submit).
+    pub fn panel(&self, op: u16, i: u16, s: u16) -> Option<Vec<i8>> {
+        let mut out = vec![0i8; (self.rank * self.rank) as usize];
+        let ok = unsafe { apw_work_panel(self.ptr, op, i, s, out.as_mut_ptr()) };
+        (ok == 1).then_some(out)
+    }
+
+    /// Every ticket of one nonce against `target` (little endian); the
+    /// lowest-numbered winner, plus the number of tickets evaluated.
+    pub fn search(&self, sigma: &[u8; 32], target_le: &[u8; 32]) -> (Option<Hit>, u64) {
+        let mut ticket = [0u16; 4];
+        let mut panel = vec![0i8; (self.rank * self.rank) as usize];
+        let mut pow = [0u8; 32];
+        let mut tickets = 0u64;
+        let found = unsafe {
+            apw_work_search(
+                self.ptr,
+                sigma.as_ptr(),
+                target_le.as_ptr(),
+                ticket.as_mut_ptr(),
+                panel.as_mut_ptr(),
+                pow.as_mut_ptr(),
+                &mut tickets,
+            )
+        };
+        let hit = (found == 1).then(|| Hit {
+            ticket: Ticket {
+                op: ticket[0],
+                i: ticket[1],
+                j: ticket[2],
+                s: ticket[3],
+            },
+            panel,
+            pow,
+        });
+        (hit, tickets)
+    }
+}
+
+impl Drop for Work {
+    fn drop(&mut self) {
+        unsafe { apw_work_free(self.ptr) }
+    }
+}
+
+/// sigma = BLAKE3("ApertureMatMul/v2/seed" || header (80 bytes) || batch_root).
+pub fn seed(header80: &[u8; 80], batch_root: &[u8; 32]) -> [u8; 32] {
+    let mut sigma = [0u8; 32];
+    unsafe { apw_seed(header80.as_ptr(), batch_root.as_ptr(), sigma.as_mut_ptr()) };
+    sigma
+}
+
+/// Kernel backend of this CPU ("scalar" or "avx512-vnni").
+pub fn backend_name() -> String {
+    unsafe { CStr::from_ptr(apw_backend_name()) }
+        .to_string_lossy()
+        .into_owned()
+}
+
+/// nVersion bit announcing the v2 header extension.
+pub const VERSION_POWV2: u32 = 0x100;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tiny_model_id_matches_node() {
+        // ApertureCoin src/chainparams.cpp regtest protocol model (tiny model, seed 1).
+        let m = Model::tiny(1).unwrap();
+        let hex: String = m.model_id().iter().map(|b| format!("{b:02x}")).collect();
+        assert!(hex.starts_with("f4cb7bf6"), "{hex}");
+    }
+
+    #[test]
+    fn search_hit_verifies_and_matches_honest_panel() {
+        let m = Model::tiny(1).unwrap();
+        let w = Work::new(m.clone(), &[vec![5, 6, 7], vec![]], 8).unwrap();
+        let sigma = [7u8; 32];
+        let mut target = [0xffu8; 32];
+        target[31] = 0x0f;
+        let (hit, tickets) = w.search(&sigma, &target);
+        let hit = hit.expect("1/16 of tickets win");
+        assert!(tickets >= 1);
+        assert_eq!(
+            m.ticket_pow(8, &sigma, hit.ticket, &hit.panel),
+            Some(hit.pow)
+        );
+        assert_eq!(
+            w.panel(hit.ticket.op, hit.ticket.i, hit.ticket.s).unwrap(),
+            hit.panel
+        );
+        // A changed panel changes the ticket hash.
+        let mut bad = hit.panel.clone();
+        bad[0] = if bad[0] == 1 { 2 } else { 1 };
+        assert_ne!(m.ticket_pow(8, &sigma, hit.ticket, &bad), Some(hit.pow));
+        // Out-of-range activation (|a| > 95) is rejected like a node does.
+        bad[0] = 100;
+        assert_eq!(m.ticket_pow(8, &sigma, hit.ticket, &bad), None);
+    }
+
+    #[test]
+    fn invalid_request_is_rejected() {
+        let m = Model::tiny(1).unwrap();
+        assert!(Work::new(m, &[vec![0xffffff]], 8).is_err());
+    }
+}
diff --git a/aperture/aperture-pouw/src/wire.rs b/aperture/aperture-pouw/src/wire.rs
new file mode 100644
index 00000000..296e0e74
--- /dev/null
+++ b/aperture/aperture-pouw/src/wire.rs
@@ -0,0 +1,355 @@
+//! Stratum V2 extension `0x4150` ("AP"), ApertureMatMul v2 useful work.
+//!
+//! Template Distribution (sv2-tp <-> pool), unchanged from ApertureCoin
+//! `contrib/sv2-tp`:
+//!
+//! | msg | name | direction | payload |
+//! |---|---|---|---|
+//! | 0x01 | UsefulWorkTemplate | TP -> pool | template_id u64, [`UsefulWork`] |
+//! | 0x02 | SubmitUsefulWorkSolution | pool -> TP | [`Solution`] |
+//!
+//! Mining protocol (pool <-> miner), added by this fork:
+//!
+//! | msg / field | name | direction | payload |
+//! |---|---|---|---|
+//! | 0x03 (channel msg) | SetUsefulWork | pool -> miner | channel_id u32, job_id u32, [`UsefulWork`] |
+//! | TLV (0x4150, 0x01) on SubmitSharesStandard | UsefulWorkShare | miner -> pool | [`ShareTicket`] |
+//!
+//! A miner negotiates the extension with RequestExtensions. The pool sends
+//! SetUsefulWork right before every NewMiningJob of a v2 template (nVersion
+//! bit 8). The miner runs the forward pass, searches tickets per nonce, and
+//! submits a SubmitSharesStandard carrying the winning ticket and its r×r
+//! activation panel in the TLV. All integers are little endian.
+
+use crate::Ticket;
+
+pub const EXTENSION_TYPE: u16 = 0x4150;
+pub const MSG_USEFUL_WORK_TEMPLATE: u8 = 0x01;
+pub const MSG_SUBMIT_USEFUL_WORK_SOLUTION: u8 = 0x02;
+pub const MSG_SET_USEFUL_WORK: u8 = 0x03;
+pub const TLV_FIELD_SHARE_TICKET: u8 = 0x01;
+
+/// Bit 15 of the frame's extension_type: the message is addressed to a channel.
+pub const CHANNEL_MSG_BIT: u16 = 0x8000;
+
+/// A template's useful work: the embedding request batch and the ticket rank.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct UsefulWork {
+    pub batch_root: [u8; 32],
+    /// Display byte order (as `getblocktemplate` and the node's logs show it).
+    pub model_id: [u8; 32],
+    pub rank: u8,
+    /// Token ids of each request, without EOS (u24 on the wire).
+    pub requests: Vec<Vec<u32>>,
+}
+
+struct Reader<'a> {
+    b: &'a [u8],
+}
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Result<&'a [u8], String> {
+        if self.b.len() < n {
+            return Err("truncated message".into());
+        }
+        let (a, rest) = self.b.split_at(n);
+        self.b = rest;
+        Ok(a)
+    }
+    fn u8(&mut self) -> Result<u8, String> {
+        Ok(self.take(1)?[0])
+    }
+    fn u16(&mut self) -> Result<u16, String> {
+        Ok(u16::from_le_bytes(self.take(2)?.try_into().unwrap()))
+    }
+    fn u32(&mut self) -> Result<u32, String> {
+        Ok(u32::from_le_bytes(self.take(4)?.try_into().unwrap()))
+    }
+    fn u64(&mut self) -> Result<u64, String> {
+        Ok(u64::from_le_bytes(self.take(8)?.try_into().unwrap()))
+    }
+    fn arr32(&mut self) -> Result<[u8; 32], String> {
+        Ok(self.take(32)?.try_into().unwrap())
+    }
+    fn done(&self) -> Result<(), String> {
+        if self.b.is_empty() {
+            Ok(())
+        } else {
+            Err("trailing bytes".into())
+        }
+    }
+}
+
+impl UsefulWork {
+    fn read(r: &mut Reader) -> Result<Self, String> {
+        let batch_root = r.arr32()?;
+        let model_id = r.arr32()?;
+        let rank = r.u8()?;
+        let count = r.u16()?;
+        let mut requests = Vec::with_capacity(count as usize);
+        for _ in 0..count {
+            let n = r.u16()?;
+            let raw = r.take(3 * n as usize)?;
+            requests.push(
+                raw.chunks(3)
+                    .map(|c| c[0] as u32 | (c[1] as u32) << 8 | (c[2] as u32) << 16)
+                    .collect(),
+            );
+        }
+        Ok(UsefulWork {
+            batch_root,
+            model_id,
+            rank,
+            requests,
+        })
+    }
+
+    fn write(&self, out: &mut Vec<u8>) {
+        out.extend_from_slice(&self.batch_root);
+        out.extend_from_slice(&self.model_id);
+        out.push(self.rank);
+        out.extend_from_slice(&(self.requests.len() as u16).to_le_bytes());
+        for ids in &self.requests {
+            out.extend_from_slice(&(ids.len() as u16).to_le_bytes());
+            for id in ids {
+                out.extend_from_slice(&id.to_le_bytes()[..3]);
+            }
+        }
+    }
+}
+
+/// UsefulWorkTemplate (TP -> pool).
+pub fn decode_useful_work_template(payload: &[u8]) -> Result<(u64, UsefulWork), String> {
+    let mut r = Reader { b: payload };
+    let template_id = r.u64()?;
+    let uw = UsefulWork::read(&mut r)?;
+    r.done()?;
+    Ok((template_id, uw))
+}
+
+pub fn encode_useful_work_template(template_id: u64, uw: &UsefulWork) -> Vec<u8> {
+    let mut out = template_id.to_le_bytes().to_vec();
+    uw.write(&mut out);
+    out
+}
+
+/// SetUsefulWork (pool -> miner).
+pub fn encode_set_useful_work(channel_id: u32, job_id: u32, uw: &UsefulWork) -> Vec<u8> {
+    let mut out = channel_id.to_le_bytes().to_vec();
+    out.extend_from_slice(&job_id.to_le_bytes());
+    uw.write(&mut out);
+    out
+}
+
+pub fn decode_set_useful_work(payload: &[u8]) -> Result<(u32, u32, UsefulWork), String> {
+    let mut r = Reader { b: payload };
+    let channel_id = r.u32()?;
+    let job_id = r.u32()?;
+    let uw = UsefulWork::read(&mut r)?;
+    r.done()?;
+    Ok((channel_id, job_id, uw))
+}
+
+/// The ticket and activation panel attached to a share.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ShareTicket {
+    pub ticket: Ticket,
+    pub panel: Vec<i8>,
+}
+
+impl ShareTicket {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(8 + self.panel.len());
+        for v in [self.ticket.op, self.ticket.i, self.ticket.j, self.ticket.s] {
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+        out.extend(self.panel.iter().map(|&a| a as u8));
+        out
+    }
+
+    pub fn decode(value: &[u8]) -> Result<Self, String> {
+        let mut r = Reader { b: value };
+        let ticket = Ticket {
+            op: r.u16()?,
+            i: r.u16()?,
+            j: r.u16()?,
+            s: r.u16()?,
+        };
+        Ok(ShareTicket {
+            ticket,
+            panel: r.b.iter().map(|&b| b as i8).collect(),
+        })
+    }
+
+    /// The TLV bytes appended to a SubmitSharesStandard payload.
+    pub fn to_tlv(&self) -> Vec<u8> {
+        let value = self.encode();
+        let mut out = EXTENSION_TYPE.to_le_bytes().to_vec();
+        out.push(TLV_FIELD_SHARE_TICKET);
+        out.extend_from_slice(&(value.len() as u16).to_le_bytes());
+        out.extend_from_slice(&value);
+        out
+    }
+}
+
+/// SubmitUsefulWorkSolution (pool -> TP): the sv2-tp rebuilds the block with
+/// the v2 header extension and submits it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Solution {
+    pub template_id: u64,
+    pub version: u32,
+    pub time: u32,
+    pub nonce: u32,
+    pub ticket: Ticket,
+    pub panel: Vec<i8>,
+    /// Serialized coinbase transaction, with witness.
+    pub coinbase: Vec<u8>,
+}
+
+impl Solution {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut out = self.template_id.to_le_bytes().to_vec();
+        out.extend_from_slice(&self.version.to_le_bytes());
+        out.extend_from_slice(&self.time.to_le_bytes());
+        out.extend_from_slice(&self.nonce.to_le_bytes());
+        for v in [self.ticket.op, self.ticket.i, self.ticket.j, self.ticket.s] {
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+        out.extend_from_slice(&(self.panel.len() as u16).to_le_bytes());
+        out.extend(self.panel.iter().map(|&a| a as u8));
+        out.extend_from_slice(&(self.coinbase.len() as u32).to_le_bytes());
+        out.extend_from_slice(&self.coinbase);
+        out
+    }
+
+    pub fn decode(payload: &[u8]) -> Result<Self, String> {
+        let mut r = Reader { b: payload };
+        let template_id = r.u64()?;
+        let (version, time, nonce) = (r.u32()?, r.u32()?, r.u32()?);
+        let ticket = Ticket {
+            op: r.u16()?,
+            i: r.u16()?,
+            j: r.u16()?,
+            s: r.u16()?,
+        };
+        let n = r.u16()? as usize;
+        let panel = r.take(n)?.iter().map(|&b| b as i8).collect();
+        let cb = r.u32()? as usize;
+        let coinbase = r.take(cb)?.to_vec();
+        r.done()?;
+        Ok(Solution {
+            template_id,
+            version,
+            time,
+            nonce,
+            ticket,
+            panel,
+            coinbase,
+        })
+    }
+}
+
+/// A complete SV2 frame (6-byte header + payload), unencrypted; the noise
+/// layer encrypts it like any other frame.
+pub fn frame(extension_type: u16, msg_type: u8, payload: &[u8]) -> Vec<u8> {
+    let len = payload.len() as u32;
+    assert!(len < 1 << 24, "SV2 payload too long");
+    let mut out = Vec::with_capacity(6 + payload.len());
+    out.extend_from_slice(&extension_type.to_le_bytes());
+    out.push(msg_type);
+    out.extend_from_slice(&len.to_le_bytes()[..3]);
+    out.extend_from_slice(payload);
+    out
+}
+
+/// Append bytes (a TLV) to a complete frame, fixing its length field.
+pub fn append_to_frame(frame: &mut Vec<u8>, extra: &[u8]) {
+    let len = u32::from_le_bytes([frame[3], frame[4], frame[5], 0]) + extra.len() as u32;
+    assert!(len < 1 << 24, "SV2 payload too long");
+    frame[3..6].copy_from_slice(&len.to_le_bytes()[..3]);
+    frame.extend_from_slice(extra);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn uw() -> UsefulWork {
+        UsefulWork {
+            batch_root: [1; 32],
+            model_id: [2; 32],
+            rank: 8,
+            requests: vec![vec![1, 0x123456], vec![]],
+        }
+    }
+
+    #[test]
+    fn round_trips() {
+        let (id, got) =
+            decode_useful_work_template(&encode_useful_work_template(9, &uw())).unwrap();
+        assert_eq!((id, got), (9, uw()));
+        let (c, j, got) = decode_set_useful_work(&encode_set_useful_work(3, 4, &uw())).unwrap();
+        assert_eq!((c, j, got), (3, 4, uw()));
+        let t = ShareTicket {
+            ticket: Ticket {
+                op: 1,
+                i: 2,
+                j: 3,
+                s: 4,
+            },
+            panel: vec![-95, 0, 95],
+        };
+        assert_eq!(ShareTicket::decode(&t.encode()).unwrap(), t);
+        let tlv = t.to_tlv();
+        assert_eq!(&tlv[..5], &[0x50, 0x41, 0x01, 11, 0]);
+        let s = Solution {
+            template_id: 7,
+            version: 0x2000_0100,
+            time: 1,
+            nonce: 2,
+            ticket: t.ticket,
+            panel: t.panel.clone(),
+            coinbase: vec![9; 10],
+        };
+        assert_eq!(Solution::decode(&s.encode()).unwrap(), s);
+        assert!(decode_useful_work_template(&[0; 3]).is_err());
+    }
+
+    #[test]
+    fn solution_layout_matches_sv2_tp() {
+        // contrib/sv2-tp rpc_mining.cpp: template_id u64 | version u32 | timestamp u32 | nonce u32 |
+        // op i j s u16 | panel_len u16 | panel | coinbase_len u32 | coinbase
+        let s = Solution {
+            template_id: 1,
+            version: 2,
+            time: 3,
+            nonce: 4,
+            ticket: Ticket {
+                op: 5,
+                i: 6,
+                j: 7,
+                s: 8,
+            },
+            panel: vec![1, -1],
+            coinbase: vec![0xaa],
+        };
+        let e = s.encode();
+        assert_eq!(e.len(), 8 + 12 + 8 + 2 + 2 + 4 + 1);
+        assert_eq!(&e[28..30], &[2, 0]);
+        assert_eq!(&e[30..32], &[1, 0xff]);
+        assert_eq!(&e[32..36], &[1, 0, 0, 0]);
+    }
+
+    #[test]
+    fn frames() {
+        let mut f = frame(
+            EXTENSION_TYPE | CHANNEL_MSG_BIT,
+            MSG_SET_USEFUL_WORK,
+            &[1, 2],
+        );
+        assert_eq!(f, vec![0x50, 0xc1, 3, 2, 0, 0, 1, 2]);
+        append_to_frame(&mut f, &[9]);
+        assert_eq!(&f[3..6], &[3, 0, 0]);
+        assert_eq!(f.len(), 9);
+    }
+}
