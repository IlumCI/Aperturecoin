index 00000000..7fcd615f
--- /dev/null
+++ b/pool-apps/pool/src/lib/aperture.rs
@@ -0,0 +1,295 @@
+//! ApertureMatMul v2 pooling (proof of useful work, ApertureCoin `doc/pouw-v2.md`).
+//!
+//! - sv2-tp announces each v2 template's embedding-request batch with
+//!   UsefulWorkTemplate (extension 0x4150, msg 0x01). The pool runs the protocol
+//!   model over the batch once per template, which gives the activations every
+//!   ticket must be taken from.
+//! - Miners get the batch with SetUsefulWork (0x4150/0x03) before each
+//!   NewMiningJob of a v2 template. They submit SubmitSharesStandard with the
+//!   winning ticket and its r×r activation panel in a 0x4150 TLV.
+//! - A share is judged by the ticket hash, which is the node's consensus check
+//!   through the `aperture_pouw` bindings. With `aperture_verify_panels`
+//!   (the default), the pool also requires the panel to equal its own
+//!   forward-pass activations. Consensus does not check this (KW hardness holds
+//!   for any A), but the pool policy does: every pooled share is then work on
+//!   the real inference, not on free-chosen matrices.
+//! - A share that meets the network target goes to sv2-tp as
+//!   SubmitUsefulWorkSolution (0x4150/0x02), and sv2-tp builds the v2 block.
+
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, Mutex, OnceLock},
+};
+
+use aperture_pouw::{
+    Model, Work,
+    wire::{self, ShareTicket, Solution, UsefulWork},
+};
+use async_channel::Sender;
+use stratum_apps::{
+    stratum_core::{
+        channels_sv2::aperture as channel_pow,
+        codec_sv2::SerializedFrame,
+        parsers_sv2::{TemplateDistributionOwned, Tlv},
+    },
+    utils::types::OutboundFrame,
+};
+use tracing::{error, info, warn};
+
+pub use stratum_apps::stratum_core::channels_sv2::aperture::VERSION_POWV2;
+
+/// Templates kept for late shares (sv2-tp keeps a similar window).
+const MAX_TEMPLATES: usize = 64;
+
+pub struct TemplateWork {
+    pub useful_work: UsefulWork,
+    pub work: Arc<Work>,
+}
+
+struct State {
+    model: Option<Arc<Model>>,
+    verify_panels: bool,
+    templates: Mutex<BTreeMap<u64, Arc<TemplateWork>>>,
+    tp_sender: Mutex<Option<Sender<OutboundFrame>>>,
+}
+
+static STATE: OnceLock<State> = OnceLock::new();
+
+fn state() -> &'static State {
+    STATE.get_or_init(|| State {
+        model: None,
+        verify_panels: true,
+        templates: Mutex::new(BTreeMap::new()),
+        tp_sender: Mutex::new(None),
+    })
+}
+
+/// Load the protocol model and install the v2 share verifier. Without a model,
+/// v2 templates cannot be pooled (their shares are rejected).
+pub fn init(
+    model_path: Option<&str>,
+    tiny_model_seed: Option<u32>,
+    verify_panels: bool,
+) -> Result<(), String> {
+    let model = match (model_path, tiny_model_seed) {
+        (Some(path), _) => Some(Model::load_file(path)?),
+        (None, Some(seed)) => Some(Model::tiny(seed)?),
+        (None, None) => None,
+    };
+    if let Some(m) = &model {
+        info!(
+            "ApertureMatMul v2: protocol model {} ({} weight matmuls, {} kernels), panel verification {}",
+            hex(&m.model_id()),
+            m.num_ops(),
+            aperture_pouw::backend_name(),
+            if verify_panels { "on" } else { "off" }
+        );
+    } else {
+        info!("ApertureMatMul v2: no protocol model configured; v2 templates cannot be pooled");
+    }
+    STATE
+        .set(State {
+            model,
+            verify_panels,
+            templates: Mutex::new(BTreeMap::new()),
+            tp_sender: Mutex::new(None),
+        })
+        .map_err(|_| "aperture state already initialized".to_string())?;
+    channel_pow::set_powv2_verifier(Box::new(verify_share));
+    Ok(())
+}
+
+pub fn enabled() -> bool {
+    state().model.is_some()
+}
+
+pub fn set_tp_sender(sender: Sender<OutboundFrame>) {
+    *state().tp_sender.lock().unwrap() = Some(sender);
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+
+fn raw_frame(bytes: Vec<u8>) -> Option<OutboundFrame> {
+    SerializedFrame::from_bytes(bytes.into())
+        .ok()
+        .map(OutboundFrame::Raw)
+}
+
+/// UsefulWorkTemplate from sv2-tp: run the forward pass (synchronously; the
+/// caller is on a runtime worker via `block_in_place`) and keep it for the
+/// template's jobs and shares. Returns the template id.
+pub fn on_useful_work_template(payload: &[u8]) -> Result<u64, (Option<u64>, String)> {
+    let (template_id, useful_work) =
+        wire::decode_useful_work_template(payload).map_err(|e| (None, e))?;
+    let fail = |e: String| (Some(template_id), e);
+    let model = state().model.clone().ok_or_else(|| {
+        fail("no protocol model configured (aperture_protocol_model / aperture_tiny_model)".into())
+    })?;
+    if useful_work.model_id != model.model_id() {
+        return Err(fail(format!(
+            "template {template_id} uses model {}, the pool has {}",
+            hex(&useful_work.model_id),
+            hex(&model.model_id())
+        )));
+    }
+    let started = std::time::Instant::now();
+    let work = Work::new(model, &useful_work.requests, useful_work.rank as u32).map_err(fail)?;
+    info!(
+        "Useful work for template {}: {} embedding requests, forward pass in {:.1} ms, rank {}",
+        template_id,
+        useful_work.requests.len(),
+        started.elapsed().as_secs_f64() * 1e3,
+        useful_work.rank
+    );
+    let mut templates = state().templates.lock().unwrap();
+    templates.insert(template_id, Arc::new(TemplateWork { useful_work, work }));
+    while templates.len() > MAX_TEMPLATES {
+        templates.pop_first();
+    }
+    Ok(template_id)
+}
+
+/// Template Distribution messages held back while a v2 template's forward pass
+/// is pending, in arrival order. `Some(id)` marks a v2 NewTemplate still
+/// waiting for its UsefulWorkTemplate; the queue drains up to the first one.
+static HELD: Mutex<Vec<(Option<u64>, TemplateDistributionOwned)>> = Mutex::new(Vec::new());
+
+/// A Template Distribution message from sv2-tp. Returns the messages to forward
+/// to the channel manager now (v2 templates wait for their useful work, so no
+/// job is announced before miners can be told its batch).
+pub fn on_template_distribution(msg: TemplateDistributionOwned) -> Vec<TemplateDistributionOwned> {
+    let waiting = match &msg {
+        TemplateDistributionOwned::NewTemplate(t)
+            if enabled() && t.version & VERSION_POWV2 != 0 =>
+        {
+            Some(t.template_id)
+        }
+        _ => None,
+    };
+    let mut held = HELD.lock().unwrap();
+    if held.is_empty() && waiting.is_none() {
+        return vec![msg];
+    }
+    held.push((waiting, msg));
+    Vec::new()
+}
+
+/// The UsefulWorkTemplate of `template_id` was processed (or failed): release
+/// the held messages up to the next template still waiting.
+pub fn release_template(template_id: u64) -> Vec<TemplateDistributionOwned> {
+    let mut held = HELD.lock().unwrap();
+    for entry in held.iter_mut() {
+        if entry.0 == Some(template_id) {
+            entry.0 = None;
+            break;
+        }
+    }
+    let n = held
+        .iter()
+        .position(|(w, _)| w.is_some())
+        .unwrap_or(held.len());
+    held.drain(..n).map(|(_, m)| m).collect()
+}
+
+pub fn template_work(template_id: u64) -> Option<Arc<TemplateWork>> {
+    state().templates.lock().unwrap().get(&template_id).cloned()
+}
+
+/// SetUsefulWork frame for a job of a v2 template.
+pub fn set_useful_work_frame(
+    channel_id: u32,
+    job_id: u32,
+    template_id: u64,
+) -> Option<OutboundFrame> {
+    let tw = template_work(template_id)?;
+    let payload = wire::encode_set_useful_work(channel_id, job_id, &tw.useful_work);
+    raw_frame(wire::frame(
+        wire::EXTENSION_TYPE | wire::CHANNEL_MSG_BIT,
+        wire::MSG_SET_USEFUL_WORK,
+        &payload,
+    ))
+}
+
+/// The ticket TLV of a share, if any.
+pub fn ticket_tlv(tlvs: Option<&[Tlv]>) -> Option<&[u8]> {
+    tlvs?
+        .iter()
+        .find(|t| {
+            t.r#type.extension_type == wire::EXTENSION_TYPE
+                && t.r#type.field_type == wire::TLV_FIELD_SHARE_TICKET
+        })
+        .map(|t| t.value.as_slice())
+}
+
+/// The channel's v2 share check (installed into `channels_sv2`).
+fn verify_share(
+    template_id: Option<u64>,
+    header: &[u8; 80],
+    ticket: &[u8],
+) -> Result<[u8; 32], &'static str> {
+    let st = state();
+    let model = st.model.as_ref().ok_or("useful-work-not-supported")?;
+    let tw = template_id
+        .and_then(template_work)
+        .ok_or("useful-work-unknown-template")?;
+    let share = ShareTicket::decode(ticket).map_err(|_| channel_pow::ERROR_CODE_POWV2_TICKET)?;
+    let rank = tw.work.rank();
+    if share.panel.len() != (rank * rank) as usize {
+        return Err(channel_pow::ERROR_CODE_POWV2_TICKET);
+    }
+    if st.verify_panels {
+        let t = share.ticket;
+        match tw.work.panel(t.op, t.i, t.s) {
+            Some(honest) if honest == share.panel => {}
+            _ => return Err("useful-work-panel-mismatch"),
+        }
+    }
+    let sigma = aperture_pouw::seed(header, &tw.useful_work.batch_root);
+    model
+        .ticket_pow(rank, &sigma, share.ticket, &share.panel)
+        .ok_or(channel_pow::ERROR_CODE_POWV2_TICKET)
+}
+
+/// Forward a v2 block found by a pooled share to sv2-tp.
+pub fn submit_solution(
+    template_id: u64,
+    version: u32,
+    time: u32,
+    nonce: u32,
+    ticket_tlv_value: &[u8],
+    coinbase: Vec<u8>,
+) {
+    let Ok(share) = ShareTicket::decode(ticket_tlv_value) else {
+        error!("v2 block found but its ticket cannot be decoded");
+        return;
+    };
+    let solution = Solution {
+        template_id,
+        version,
+        time,
+        nonce,
+        ticket: share.ticket,
+        panel: share.panel,
+        coinbase,
+    };
+    let bytes = wire::frame(
+        wire::EXTENSION_TYPE,
+        wire::MSG_SUBMIT_USEFUL_WORK_SOLUTION,
+        &solution.encode(),
+    );
+    let sender = state().tp_sender.lock().unwrap().clone();
+    match (sender, raw_frame(bytes)) {
+        (Some(sender), Some(frame)) => {
+            if sender.try_send(frame).is_err() {
+                error!("could not send SubmitUsefulWorkSolution to the Template Provider");
+            } else {
+                info!(
+                    "SubmitUsefulWorkSolution for template {template_id} sent to the Template Provider"
+                );
+            }
+        }
+        _ => warn!("v2 block found but no Template Provider connection to submit it to"),
+    }
+}
