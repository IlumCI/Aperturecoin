diff -ruN '--exclude=target' stratum/sv2/channels-sv2/src/aperture.rs sv2-apps/aperture/stratum-patches/channels-sv2/src/aperture.rs
--- a/src/aperture.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/aperture.rs	2026-09-30 16:49:02.053942661 +0000
@@ -0,0 +1,149 @@
+//! ApertureCoin proof of work for share validation (ApertureMatMul, see the
+//! `aperture_pow` crate). The pool, JD client and translator all validate
+//! shares through the channel types in this crate, so this is the single
+//! place where the header's proof-of-work hash is computed.
+
+use bitcoin::{block::Header, hashes::Hash, BlockHash};
+
+#[cfg(test)]
+thread_local! {
+    /// The upstream unit tests of this crate use nonces mined for double-SHA256.
+    /// They keep testing channel logic unchanged; ApertureMatMul is covered by
+    /// the tests below, which switch this off for their own thread.
+    pub(crate) static SHA256D_FOR_UPSTREAM_TESTS: core::cell::Cell<bool> = const { core::cell::Cell::new(true) };
+}
+
+/// ApertureMatMul proof-of-work hash of a header, typed as a `BlockHash` so the
+/// existing target comparisons (`Target::is_met_by`, little-endian) apply.
+pub fn pow_block_hash(header: &Header) -> BlockHash {
+    #[cfg(test)]
+    if SHA256D_FOR_UPSTREAM_TESTS.with(|c| c.get()) {
+        return header.block_hash();
+    }
+    let raw = bitcoin::consensus::serialize(header);
+    let bytes: [u8; 80] = raw.as_slice().try_into().expect("block headers serialize to 80 bytes");
+    BlockHash::from_byte_array(aperture_pow::pow_hash(&bytes))
+}
+
+/// nVersion bit of an ApertureMatMul v2 (proof of useful work) header.
+pub const VERSION_POWV2: u32 = 0x100;
+
+/// Verifies a v2 share: `(template_id, 80-byte header, ticket TLV value)` to the
+/// ticket's proof-of-work hash (raw bytes, compared little endian), or the
+/// SV2 error code to reject it with. Registered by the application, which
+/// holds the protocol model; this crate has no model.
+pub type PowV2Verifier = dyn Fn(Option<u64>, &[u8; 80], &[u8]) -> Result<[u8; 32], &'static str> + Send + Sync;
+
+static POWV2_VERIFIER: std::sync::OnceLock<Box<PowV2Verifier>> = std::sync::OnceLock::new();
+
+/// Install the v2 share verifier (once per process).
+pub fn set_powv2_verifier(f: Box<PowV2Verifier>) -> bool {
+    POWV2_VERIFIER.set(f).is_ok()
+}
+
+/// Error code for a v2 job share without a valid ticket.
+pub const ERROR_CODE_POWV2_TICKET: &str = "invalid-useful-work-ticket";
+
+/// Proof-of-work hash of a share: ApertureMatMul v1 for v1 jobs; for v2 jobs
+/// the ticket hash of the attached ticket, checked by the registered verifier.
+pub(crate) fn share_pow_hash(
+    job_version: u32,
+    template_id: Option<u64>,
+    header: &Header,
+    ticket: Option<&[u8]>,
+) -> Result<BlockHash, &'static str> {
+    if job_version & VERSION_POWV2 == 0 {
+        return Ok(pow_block_hash(header));
+    }
+    let (Some(ticket), Some(verify)) = (ticket, POWV2_VERIFIER.get()) else {
+        return Err(ERROR_CODE_POWV2_TICKET);
+    };
+    let raw = bitcoin::consensus::serialize(header);
+    let bytes: [u8; 80] = raw.as_slice().try_into().expect("block headers serialize to 80 bytes");
+    verify(template_id, &bytes, ticket).map(BlockHash::from_byte_array)
+}
+
+/// Set the network's ApertureMatMul matrix dimension (512 main/test, 32 regtest).
+pub fn set_pow_dim(n: u32) {
+    aperture_pow::set_dim(n);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bitcoin::{block::Version, CompactTarget, Target, TxMerkleNode};
+
+    fn header(nonce: u32) -> Header {
+        Header {
+            version: Version::from_consensus(0x2000_0000),
+            prev_blockhash: BlockHash::from_byte_array([7u8; 32]),
+            merkle_root: TxMerkleNode::from_byte_array([9u8; 32]),
+            time: 1_790_640_000,
+            bits: CompactTarget::from_consensus(0x207f_ffff),
+            nonce,
+        }
+    }
+
+    #[test]
+    fn pow_is_apertures_matmul_not_sha256d() {
+        SHA256D_FOR_UPSTREAM_TESTS.with(|c| c.set(false));
+        aperture_pow::set_dim(32);
+        let h = header(42);
+        let raw: [u8; 80] = bitcoin::consensus::serialize(&h).try_into().unwrap();
+        assert_eq!(pow_block_hash(&h).to_byte_array(), aperture_pow::matmul_v1(&raw, 32));
+        assert_ne!(pow_block_hash(&h), h.block_hash());
+    }
+
+    #[test]
+    fn targets_compare_the_matmul_hash() {
+        SHA256D_FOR_UPSTREAM_TESTS.with(|c| c.set(false));
+        aperture_pow::set_dim(32);
+        // A share target of 1/16: find a nonce that meets it by ApertureMatMul
+        // and check that the decision differs from double-SHA256 somewhere.
+        let target = Target::from_le_bytes({
+            let mut t = [0xffu8; 32];
+            t[31] = 0x0f;
+            t
+        });
+        let mut differs = false;
+        let mut found = false;
+        for nonce in 0..400 {
+            let h = header(nonce);
+            let by_matmul = target.is_met_by(pow_block_hash(&h));
+            let by_sha = target.is_met_by(h.block_hash());
+            found |= by_matmul;
+            differs |= by_matmul != by_sha;
+        }
+        assert!(found && differs);
+    }
+
+    #[test]
+    fn v2_jobs_need_a_verified_ticket() {
+        let header = Header {
+            version: bitcoin::block::Version::from_consensus(0x2000_0100),
+            prev_blockhash: BlockHash::all_zeros(),
+            merkle_root: bitcoin::TxMerkleNode::all_zeros(),
+            time: 1,
+            bits: bitcoin::CompactTarget::from_consensus(0x207fffff),
+            nonce: 2,
+        };
+        assert!(set_powv2_verifier(Box::new(|template_id, h, t| {
+            assert_eq!(template_id, Some(7));
+            assert_eq!(h[0..4], 0x2000_0100u32.to_le_bytes());
+            if t == [1, 2] {
+                Ok([9; 32])
+            } else {
+                Err("bad-ticket")
+            }
+        })));
+        // v2 job: no ticket, a bad ticket, a good ticket.
+        assert_eq!(share_pow_hash(VERSION_POWV2, Some(7), &header, None), Err(ERROR_CODE_POWV2_TICKET));
+        assert_eq!(share_pow_hash(VERSION_POWV2, Some(7), &header, Some(&[3])), Err("bad-ticket"));
+        assert_eq!(
+            share_pow_hash(VERSION_POWV2, Some(7), &header, Some(&[1, 2])).unwrap(),
+            BlockHash::from_byte_array([9; 32])
+        );
+        // v1 job: the ticket is ignored, the header hash is used.
+        assert_eq!(share_pow_hash(0x2000_0000, Some(7), &header, Some(&[1, 2])).unwrap(), pow_block_hash(&header));
+    }
+}
