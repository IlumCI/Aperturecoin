diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index b0e3f52..4acbddf 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -97,6 +97,29 @@ target_link_libraries(bitcoin_common
 
 include(InstallBinaryComponent)
 
+# ApertureCoin: JSON-RPC Mining backend (ApertureCoin Core 0.21 has no Mining
+# IPC interface) and the reference Stratum V2 CPU miner. Sources shared with
+# the node (univalue, ApertureMatMul, BLAKE3) come from APERTURE_SRC.
+set(APERTURE_SRC "" CACHE PATH "Path to the ApertureCoin source tree")
+if(NOT APERTURE_SRC OR NOT EXISTS "${APERTURE_SRC}/src/crypto/matmulpow.cpp")
+  message(FATAL_ERROR "Set -DAPERTURE_SRC=<path to the ApertureCoin source tree>")
+endif()
+add_library(aperture_univalue STATIC EXCLUDE_FROM_ALL
+  ${APERTURE_SRC}/src/univalue/lib/univalue.cpp
+  ${APERTURE_SRC}/src/univalue/lib/univalue_get.cpp
+  ${APERTURE_SRC}/src/univalue/lib/univalue_read.cpp
+  ${APERTURE_SRC}/src/univalue/lib/univalue_write.cpp
+)
+target_include_directories(aperture_univalue PUBLIC ${APERTURE_SRC}/src/univalue/include)
+add_library(aperture_rpc STATIC EXCLUDE_FROM_ALL
+  aperture/rpc_client.cpp
+  aperture/rpc_mining.cpp
+)
+target_link_libraries(aperture_rpc
+  PRIVATE core_interface
+  PUBLIC aperture_univalue bitcoin_sv2
+)
+
 if(BUILD_MINE)
   add_executable(sv2-tp
     sv2-tp.cpp
@@ -108,8 +131,23 @@ if(BUILD_MINE)
     core_interface
     $<$<BOOL:${ENABLE_IPC}>:bitcoin_ipc>
     bitcoin_sv2 # bitcoin_common now transitively provided PUBLIC by bitcoin_sv2
+    aperture_rpc
   )
   install_binary_component(sv2-tp HAS_MANPAGE)
+
+  add_executable(aperture-sv2-miner
+    aperture-sv2-miner.cpp
+    aperture/blake3_unit.cpp
+    ${APERTURE_SRC}/src/crypto/matmulpow.cpp
+  )
+  # AFTER: sv2-tp's own headers take precedence; only crypto/matmulpow.h and
+  # crypto/blake3/ are taken from the ApertureCoin tree.
+  target_include_directories(aperture-sv2-miner AFTER PRIVATE ${APERTURE_SRC}/src)
+  target_link_libraries(aperture-sv2-miner
+    core_interface
+    bitcoin_sv2
+  )
+  install_binary_component(aperture-sv2-miner)
 endif()
 
