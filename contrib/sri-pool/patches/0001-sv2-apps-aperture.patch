+//! Compiles the ApertureCoin consensus sources this crate binds to, from the
+//! ApertureCoin tree named by `APERTURE_SRC`, so the pool and the miner run the
+//! node's exact code (no second implementation of consensus rules).
+use std::path::PathBuf;
+
+fn main() {
+    println!("cargo:rerun-if-env-changed=APERTURE_SRC");
+    println!("cargo:rerun-if-changed=cpp/shim.cpp");
+    let src = std::env::var("APERTURE_SRC").map(PathBuf::from).unwrap_or_else(|_| {
+        panic!("set APERTURE_SRC to the ApertureCoin source tree (the directory containing src/crypto/matmulpow_v2.cpp)")
+    });
+    let s = src.join("src");
+    assert!(
+        s.join("crypto/matmulpow_v2.cpp").exists(),
+        "APERTURE_SRC={} is not an ApertureCoin source tree with ApertureMatMul v2",
+        src.display()
+    );
+    for f in [
+        "crypto/matmulpow_v2.cpp",
+        "crypto/matmulpow_v2_kernel.cpp",
+        "model/apm.cpp",
+        "model/intmodel.cpp",
+    ] {
+        println!("cargo:rerun-if-changed={}", s.join(f).display());
+    }
+
+    // The C++ archive first: static libraries are resolved left to right.
+    cc::Build::new()
+        .cpp(true)
+        .std("c++17")
+        .files([
+            s.join("crypto/matmulpow_v2.cpp"),
+            s.join("crypto/matmulpow_v2_kernel.cpp"),
+            s.join("model/apm.cpp"),
+            s.join("model/intmodel.cpp"),
+            s.join("univalue/lib/univalue.cpp"),
+            s.join("univalue/lib/univalue_get.cpp"),
+            s.join("univalue/lib/univalue_read.cpp"),
+            s.join("univalue/lib/univalue_write.cpp"),
+            PathBuf::from("cpp/shim.cpp"),
+        ])
+        .include(&s)
+        .include(s.join("univalue/include"))
+        .opt_level(3)
+        .warnings(false)
+        .compile("aperture_pouw_cpp");
+    cc::Build::new()
+        .files(
+            ["blake3.c", "blake3_dispatch.c", "blake3_portable.c"]
+                .map(|f| s.join("crypto/blake3").join(f)),
+        )
+        .include(s.join("crypto/blake3"))
+        .define("BLAKE3_NO_AVX512", "1")
+        .define("BLAKE3_NO_AVX2", "1")
+        .define("BLAKE3_NO_SSE41", "1")
+        .define("BLAKE3_NO_SSE2", "1")
+        .opt_level(3)
+        .warnings(false)
+        .compile("aperture_blake3");
+}
