diff --git a/aperture/aperture-pow/src/lib.rs b/aperture/aperture-pow/src/lib.rs
new file mode 100644
index 00000000..db3e1721
--- /dev/null
+++ b/aperture/aperture-pow/src/lib.rs
@@ -0,0 +1,150 @@
+//! ApertureCoin proof of work for the Stratum V2 reference implementation.
+//!
+//! ApertureMatMul v1 (ApertureCoin `doc/matmulpow.md`), a bit-exact port of
+//! `src/crypto/matmulpow.cpp`:
+//!
+//! ```text
+//! S      = BLAKE3-XOF("ApertureMatMul/v1" || header, 2*n*n)
+//! A, B   = S[0..n*n], S[n*n..2*n*n] as row-major int8 n x n matrices
+//! C      = A * B with exact int32 accumulation
+//! digest = BLAKE3(C as row-major int32 little-endian)
+//! pow    = BLAKE3(header || digest)          (compared as a little-endian uint256)
+//! ```
+//!
+//! The block *identifier* stays double-SHA256 of the header; only the
+//! proof-of-work comparison uses `pow`.
+
+use std::sync::atomic::{AtomicU32, Ordering};
+
+const TAG_V1: &[u8] = b"ApertureMatMul/v1";
+
+/// Matrix dimension of the active network: 512 on main/test, 32 on regtest.
+/// 0 means "not set yet": the first [`dim`] call reads `APERTURE_POW_DIM` or
+/// falls back to 512.
+static DIM: AtomicU32 = AtomicU32::new(0);
+
+/// Default dimension of a network by the node's `-chain` name.
+pub fn dim_for_network(network: &str) -> Option<u32> {
+    match network {
+        "main" | "mainnet" | "bitcoin" | "test" | "testnet" | "testnet4" | "signet" => Some(512),
+        "regtest" => Some(32),
+        _ => None,
+    }
+}
+
+/// Valid dimensions: multiples of 16 in 16..=4096 (same rule as the node).
+pub fn is_valid_dim(n: u32) -> bool {
+    (16..=4096).contains(&n) && n % 16 == 0
+}
+
+/// Set the network's matrix dimension (call once at startup from the config).
+pub fn set_dim(n: u32) {
+    assert!(is_valid_dim(n), "invalid ApertureMatMul dimension {n}");
+    DIM.store(n, Ordering::Relaxed);
+}
+
+/// Active dimension. Unless [`set_dim`] was called, it comes from the
+/// environment: `APERTURE_POW_DIM=<n>` or `APERTURE_NETWORK=<main|test|regtest>`,
+/// default 512 (main/test). Every SRI role (pool, JD client, translator, mining
+/// device) must use the node's value or every share is rejected.
+pub fn dim() -> u32 {
+    let d = DIM.load(Ordering::Relaxed);
+    if d != 0 {
+        return d;
+    }
+    let env = std::env::var("APERTURE_POW_DIM")
+        .ok()
+        .and_then(|v| v.parse::<u32>().ok())
+        .or_else(|| {
+            std::env::var("APERTURE_NETWORK")
+                .ok()
+                .and_then(|n| dim_for_network(&n))
+        })
+        .unwrap_or(512);
+    assert!(is_valid_dim(env), "invalid APERTURE_POW_DIM {env}");
+    let _ = DIM.compare_exchange(0, env, Ordering::Relaxed, Ordering::Relaxed);
+    DIM.load(Ordering::Relaxed)
+}
+
+/// ApertureMatMul v1 proof-of-work hash of an 80-byte header, raw bytes
+/// (interpret as little-endian uint256 against the target).
+pub fn matmul_v1(header: &[u8; 80], n: u32) -> [u8; 32] {
+    assert!(is_valid_dim(n));
+    let n = n as usize;
+    let nn = n * n;
+    let mut s = vec![0u8; 2 * nn];
+    let mut h = blake3::Hasher::new();
+    h.update(TAG_V1);
+    h.update(header);
+    h.finalize_xof().fill(&mut s);
+    let (a, b) = s.split_at(nn);
+    let mut c = vec![0i32; nn];
+    for i in 0..n {
+        let crow = &mut c[i * n..(i + 1) * n];
+        for k in 0..n {
+            let aik = a[i * n + k] as i8 as i32;
+            if aik == 0 {
+                continue;
+            }
+            let brow = &b[k * n..(k + 1) * n];
+            for (cj, &bkj) in crow.iter_mut().zip(brow) {
+                *cj += aik * (bkj as i8 as i32);
+            }
+        }
+    }
+    let mut hc = blake3::Hasher::new();
+    let mut buf = Vec::with_capacity(nn * 4);
+    for v in &c {
+        buf.extend_from_slice(&v.to_le_bytes());
+    }
+    hc.update(&buf);
+    let digest = hc.finalize();
+    let mut ho = blake3::Hasher::new();
+    ho.update(header);
+    ho.update(digest.as_bytes());
+    *ho.finalize().as_bytes()
+}
+
+/// v1 proof-of-work hash with the configured network dimension.
+pub fn pow_hash(header: &[u8; 80]) -> [u8; 32] {
+    matmul_v1(header, dim())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn hex(b: &[u8]) -> String {
+        b.iter().map(|x| format!("{x:02x}")).collect()
+    }
+
+    #[test]
+    fn node_test_vectors() {
+        // Shared with ApertureCoin src/test/matmulpow_tests.cpp.
+        let mut header = [0u8; 80];
+        for (i, b) in header.iter_mut().enumerate() {
+            *b = (i * 7 + 3) as u8;
+        }
+        assert_eq!(
+            hex(&matmul_v1(&header, 16)),
+            "d7ee1fb0146153fe17204659e4e8874d4e3574dae638e6a8084fec7efb0587a9"
+        );
+        assert_eq!(
+            hex(&matmul_v1(&header, 32)),
+            "e24c46295e05285325ea259f97f9506dcf3322d40f958636cbc7239cc03fff6a"
+        );
+        assert_eq!(
+            hex(&matmul_v1(&header, 64)),
+            "f75725f63275bd521e7f224592fdfd0b1cf14299b6d7fab6ce0ed6d3d93ec79e"
+        );
+        assert_eq!(
+            hex(&matmul_v1(&header, 512)),
+            "3347007498a9035dc1ba2174094efcbc3f80684deb9c1cb54dc9c933fc5f71ba"
+        );
+    }
+
+    #[test]
+    fn dims() {
+        assert!(is_valid_dim(32) && is_valid_dim(512) && !is_valid_dim(8) && !is_valid_dim(520));
+    }
+}
