diff -ruN '--exclude=target' stratum/sv2/channels-sv2/src/aperture.rs sv2-apps/aperture/stratum-patches/channels-sv2/src/aperture.rs
--- a/src/aperture.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/aperture.rs	2026-09-30 16:07:25.837707407 +0000
@@ -0,0 +1,81 @@
+//! ApertureCoin proof of work for share validation (ApertureMatMul, see the
+//! `aperture_pow` crate). The pool, JD client and translator all validate
+//! shares through the channel types in this crate, so this is the single
+//! place where the header's proof-of-work hash is computed.
+
+use bitcoin::{block::Header, hashes::Hash, BlockHash};
+
+#[cfg(test)]
+thread_local! {
+    /// The upstream unit tests of this crate use nonces mined for double-SHA256.
+    /// They keep testing channel logic unchanged; ApertureMatMul is covered by
+    /// the tests below, which switch this off for their own thread.
+    pub(crate) static SHA256D_FOR_UPSTREAM_TESTS: core::cell::Cell<bool> = const { core::cell::Cell::new(true) };
+}
+
+/// ApertureMatMul proof-of-work hash of a header, typed as a `BlockHash` so the
+/// existing target comparisons (`Target::is_met_by`, little-endian) apply.
+pub fn pow_block_hash(header: &Header) -> BlockHash {
+    #[cfg(test)]
+    if SHA256D_FOR_UPSTREAM_TESTS.with(|c| c.get()) {
+        return header.block_hash();
+    }
+    let raw = bitcoin::consensus::serialize(header);
+    let bytes: [u8; 80] = raw.as_slice().try_into().expect("block headers serialize to 80 bytes");
+    BlockHash::from_byte_array(aperture_pow::pow_hash(&bytes))
+}
+
+/// Set the network's ApertureMatMul matrix dimension (512 main/test, 32 regtest).
+pub fn set_pow_dim(n: u32) {
+    aperture_pow::set_dim(n);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bitcoin::{block::Version, CompactTarget, Target, TxMerkleNode};
+
+    fn header(nonce: u32) -> Header {
+        Header {
+            version: Version::from_consensus(0x2000_0000),
+            prev_blockhash: BlockHash::from_byte_array([7u8; 32]),
+            merkle_root: TxMerkleNode::from_byte_array([9u8; 32]),
+            time: 1_790_640_000,
+            bits: CompactTarget::from_consensus(0x207f_ffff),
+            nonce,
+        }
+    }
+
+    #[test]
+    fn pow_is_apertures_matmul_not_sha256d() {
+        SHA256D_FOR_UPSTREAM_TESTS.with(|c| c.set(false));
+        aperture_pow::set_dim(32);
+        let h = header(42);
+        let raw: [u8; 80] = bitcoin::consensus::serialize(&h).try_into().unwrap();
+        assert_eq!(pow_block_hash(&h).to_byte_array(), aperture_pow::matmul_v1(&raw, 32));
+        assert_ne!(pow_block_hash(&h), h.block_hash());
+    }
+
+    #[test]
+    fn targets_compare_the_matmul_hash() {
+        SHA256D_FOR_UPSTREAM_TESTS.with(|c| c.set(false));
+        aperture_pow::set_dim(32);
+        // A share target of 1/16: find a nonce that meets it by ApertureMatMul
+        // and check that the decision differs from double-SHA256 somewhere.
+        let target = Target::from_le_bytes({
+            let mut t = [0xffu8; 32];
+            t[31] = 0x0f;
+            t
+        });
+        let mut differs = false;
+        let mut found = false;
+        for nonce in 0..400 {
+            let h = header(nonce);
+            let by_matmul = target.is_met_by(pow_block_hash(&h));
+            let by_sha = target.is_met_by(h.block_hash());
+            found |= by_matmul;
+            differs |= by_matmul != by_sha;
+        }
+        assert!(found && differs);
+    }
+}
