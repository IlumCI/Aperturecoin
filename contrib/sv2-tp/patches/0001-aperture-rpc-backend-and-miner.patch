diff --git a/src/sv2/messages.cpp b/src/sv2/messages.cpp
index 9130007..61e7637 100644
--- a/src/sv2/messages.cpp
+++ b/src/sv2/messages.cpp
@@ -60,17 +60,17 @@ node::CoinbaseTx ExtractCoinbaseTx(const CTransactionRef coinbase_tx)
 
     coinbase.sequence = coinbase_tx->vin[0].nSequence;
 
-    // Extract only OP_RETURN coinbase outputs (witness commitment, merge
-    // mining, etc). BlockAssembler::CreateNewBlock adds a dummy output with
-    // the full reward that we must exclude.
-    for (const auto& output : coinbase_tx->vout) {
-        if (!output.scriptPubKey.empty() && output.scriptPubKey[0] == OP_RETURN) {
-            coinbase.required_outputs.push_back(output);
-        } else {
-            // The (single) dummy coinbase output produced by CreateBlock() has
-            // an nValue set to nFee + the Block Subsidy.
-            Assume(coinbase.block_reward_remaining == 0);
+    // ApertureCoin: output 0 is the placeholder carrying the reward available
+    // to the miner; every further output (development fund, witness
+    // commitment) is mandatory and forwarded as coinbase_tx_outputs.
+    // Upstream kept only OP_RETURN outputs, which would drop the
+    // consensus-required development fund payment.
+    for (size_t i = 0; i < coinbase_tx->vout.size(); ++i) {
+        const auto& output{coinbase_tx->vout[i]};
+        if (i == 0) {
             coinbase.block_reward_remaining = output.nValue;
+        } else {
+            coinbase.required_outputs.push_back(output);
         }
     }
 
