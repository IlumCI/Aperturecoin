+# SRI pool for ApertureCoin (SCIENCE) mainnet, fed by sv2-tp next to apertured.
+# Start sv2-tp from the ApertureCoin repository (contrib/sv2-tp) and copy the
+# "authority key" it logs into [template_provider_type.Sv2Tp].public_key.
+authority_public_key = "<pool authority public key>"
+authority_secret_key = "<pool authority secret key>"
+cert_validity_sec = 3600
+listen_address = "0.0.0.0:34254"
+
+# ApertureCoin addresses are accepted in addr(): sci1... (bech32/bech32m),
+# A... (P2PKH), a... (P2SH). raw(<hex script>) and other descriptors also work.
+coinbase_reward_script = "addr(<sci1... pool payout address>)"
+
+server_id = 1
+pool_signature = "ApertureCoin SRI pool"
+shares_per_minute = 6.0
+share_batch_size = 10
+
+# ApertureMatMul matrix dimension: 512 on main and test, 32 on regtest. Must
+# match the node, or every share is rejected. Miners, translators and JD
+# clients take the same value from APERTURE_POW_DIM (or APERTURE_NETWORK).
+aperture_pow_dim = 512
+
+[template_provider_type.Sv2Tp]
+address = "127.0.0.1:8442"
+public_key = "<sv2-tp authority key>"
