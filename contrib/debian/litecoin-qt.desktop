[Desktop Entry]
Version=1.0
Name=ApertureCoin Core
Comment=Connect to the ApertureCoin P2P Network
Comment[de]=Verbindung mit dem ApertureCoin Peer-to-Peer-Netzwerk herstellen
Comment[es]=Conectar a la red P2P de ApertureCoin
Comment[fr]=Se connecter au réseau pair à pair ApertureCoin
GenericName=Cryptocurrency Wallet
Exec=aperture-qt %u
Terminal=false
Type=Application
Icon=aperture128
MimeType=x-scheme-handler/aperture;
Categories=Office;Finance;Network;
Keywords=aperture;crypto;cryptocurrency;wallet;blockchain;
StartupNotify=true
StartupWMClass=ApertureCoin-qt
