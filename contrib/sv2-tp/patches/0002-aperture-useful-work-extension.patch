+void Sv2TemplateProvider::ExtensionMessage(Sv2Client& client, const node::Sv2NetMsg& msg)
+{
+    if (msg.m_extension_type != node::SV2_EXT_APERTURE || uint8_t(msg.m_msg_type) != node::APERTURE_SUBMIT_USEFUL_WORK || msg.m_msg.size() < 8) {
+        LogPrintLevel(BCLog::SV2, BCLog::Level::Warning, "Ignoring extension 0x%04x message 0x%02x from client id=%zu\n",
+                      msg.m_extension_type, uint8_t(msg.m_msg_type), client.m_id);
+        return;
+    }
+    uint64_t template_id;
+    SpanReader{std::span<const uint8_t>{msg.m_msg}.first(8)} >> template_id;
+    std::shared_ptr<BlockTemplate> block_template;
+    {
+        LOCK(m_tp_mutex);
+        auto cached = m_block_template_cache.find(template_id);
+        if (cached == m_block_template_cache.end()) {
+            LogPrintLevel(BCLog::SV2, BCLog::Level::Debug, "Template with id=%lu is no longer in cache\n", template_id);
+            return;
+        }
+        block_template = cached->second.second;
+    }
+    std::string reason;
+    const bool submitted{block_template->apertureSubmitUsefulWork({msg.m_msg.begin() + 8, msg.m_msg.end()}, reason)};
+    if (!submitted) {
+        LogWarning("Useful-work block was not accepted: %s\n", reason.empty() ? std::string{"unknown reason"} : reason);
+    } else {
+        LogPrintLevel(BCLog::SV2, BCLog::Level::Debug, "Useful-work block for template id=%lu accepted\n", template_id);
+    }
+}
