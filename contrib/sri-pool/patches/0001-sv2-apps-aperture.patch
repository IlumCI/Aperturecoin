@@ -0,0 +1,584 @@
+//! Stratum V2 pool miner for ApertureCoin.
+//!
+//! Mines standard channels of an SRI pool (this fork):
+//! - **v2 jobs** (nVersion bit 8): the pool sends each job's embedding-request
+//!   batch with SetUsefulWork (extension 0x4150). The miner runs the protocol
+//!   model over the batch (the useful work), then for every nonce searches all
+//!   r×r×r tickets of the noisy forward-pass matmuls. A winning ticket and its
+//!   activation panel go into the share's 0x4150 TLV. The search uses the
+//!   node's own kernels (AVX-512 VNNI where available) via `aperture_pouw`.
+//! - **v1 jobs**: ApertureMatMul v1 over the header.
+//!
+//! ```text
+//! aperture-pouw-miner --pool 127.0.0.1:34254 [--pool-key <authority key>] --user <identity>
+//!                     (--protocolmodel <file.apm> | --tinymodel [seed]) [--threads N]
+//!                     [--hashrate <tickets/s>] [--rank 32] [--shares N] [--corrupt-panels]
+//! ```
+//!
+//! Each submitted share is printed as
+//! `share job=<id> nonce=<n> ticket=<op>,<i>,<j>,<s> pow=<hex> header=<80-byte hex>`,
+//! and each pool answer as `accepted ...` or `rejected <code>`.
+
+use aperture_pouw::{
+    wire::{self, ShareTicket, UsefulWork},
+    Model, Work,
+};
+use std::{
+    collections::HashMap,
+    net::ToSocketAddrs,
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        Arc, Mutex,
+    },
+    time::{Duration, Instant},
+};
+use stratum_apps::{
+    key_utils::Secp256k1PublicKey,
+    network_helpers::noise_connection::Connection,
+    stratum_core::{
+        binary_sv2::Seq064KOwned,
+        codec_sv2::{EncodableFrame, SerializedFrame},
+        common_messages_sv2::{Protocol, SetupConnectionOwned},
+        extensions_sv2::RequestExtensionsOwned,
+        mining_sv2::{OpenStandardMiningChannelOwned, SubmitSharesStandardOwned},
+        noise_sv2::Initiator,
+        parsers_sv2::{
+            parse_message_frame_with_tlvs, AnyMessageOwned, CommonMessagesOwned,
+            ExtensionsNegotiationOwned, ExtensionsOwned, MiningOwned,
+        },
+    },
+    utils::types::OutboundFrame,
+};
+use tokio::net::TcpStream;
+use tokio_util::sync::CancellationToken;
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+
+struct Args {
+    pool: String,
+    pool_key: Option<String>,
+    user: String,
+    model_path: Option<String>,
+    tiny_seed: Option<u32>,
+    threads: usize,
+    hashrate: Option<f32>,
+    rank: u32,
+    shares: Option<u64>,
+    corrupt_panels: bool,
+}
+
+fn parse_args() -> Result<Args, String> {
+    let mut a = Args {
+        pool: String::new(),
+        pool_key: None,
+        user: "aperture-pouw-miner".into(),
+        model_path: None,
+        tiny_seed: None,
+        threads: std::thread::available_parallelism()
+            .map(|n| n.get())
+            .unwrap_or(1),
+        hashrate: None,
+        rank: 32,
+        shares: None,
+        corrupt_panels: false,
+    };
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let mut k = 0;
+    while k < args.len() {
+        let key = args[k].as_str();
+        let val = |k: usize| {
+            args.get(k + 1)
+                .cloned()
+                .ok_or(format!("{key} needs a value"))
+        };
+        let parse = |v: String| v.parse::<u64>().map_err(|e| format!("{key}: {e}"));
+        match key {
+            "--pool" => (a.pool, k) = (val(k)?, k + 1),
+            "--pool-key" => (a.pool_key, k) = (Some(val(k)?), k + 1),
+            "--user" => (a.user, k) = (val(k)?, k + 1),
+            "--protocolmodel" => (a.model_path, k) = (Some(val(k)?), k + 1),
+            "--tinymodel" => {
+                // Optional seed (regtest uses 1).
+                match args.get(k + 1).and_then(|v| v.parse::<u32>().ok()) {
+                    Some(seed) => (a.tiny_seed, k) = (Some(seed), k + 1),
+                    None => a.tiny_seed = Some(1),
+                }
+            }
+            "--threads" => (a.threads, k) = (parse(val(k)?)? as usize, k + 1),
+            "--hashrate" => {
+                (a.hashrate, k) = (
+                    Some(val(k)?.parse().map_err(|e| format!("--hashrate: {e}"))?),
+                    k + 1,
+                )
+            }
+            "--rank" => (a.rank, k) = (parse(val(k)?)? as u32, k + 1),
+            "--shares" => (a.shares, k) = (Some(parse(val(k)?)?), k + 1),
+            "--corrupt-panels" => a.corrupt_panels = true,
+            "-h" | "--help" => {
+                println!(
+                    "{}",
+                    include_str!("main.rs")
+                        .lines()
+                        .take_while(|l| l.starts_with("//!"))
+                        .map(|l| l.trim_start_matches("//!").trim_start())
+                        .collect::<Vec<_>>()
+                        .join("\n")
+                );
+                std::process::exit(0);
+            }
+            _ => return Err(format!("unknown argument {key}")),
+        }
+        k += 1;
+    }
+    if a.pool.is_empty() {
+        return Err("--pool is required".into());
+    }
+    if a.model_path.is_none() && a.tiny_seed.is_none() {
+        return Err("--protocolmodel <file.apm> or --tinymodel is required".into());
+    }
+    a.threads = a.threads.max(1);
+    Ok(a)
+}
+
+/// Work of the active job, shared with the mining threads.
+struct Job {
+    channel_id: u32,
+    job_id: u32,
+    version: u32,
+    prev_hash: [u8; 32],
+    merkle_root: [u8; 32],
+    nbits: u32,
+    ntime: u32,
+    target_le: [u8; 32],
+    /// v2 jobs: the forward pass and the batch_root.
+    useful: Option<(Arc<Work>, [u8; 32])>,
+}
+
+impl Job {
+    fn header(&self, nonce: u32) -> [u8; 80] {
+        let mut h = [0u8; 80];
+        h[0..4].copy_from_slice(&self.version.to_le_bytes());
+        h[4..36].copy_from_slice(&self.prev_hash);
+        h[36..68].copy_from_slice(&self.merkle_root);
+        h[68..72].copy_from_slice(&self.ntime.to_le_bytes());
+        h[72..76].copy_from_slice(&self.nbits.to_le_bytes());
+        h[76..80].copy_from_slice(&nonce.to_le_bytes());
+        h
+    }
+}
+
+struct Found {
+    job: Arc<Job>,
+    nonce: u32,
+    pow: [u8; 32],
+    ticket: Option<ShareTicket>,
+}
+
+fn meets(hash: &[u8; 32], target: &[u8; 32]) -> bool {
+    for i in (0..32).rev() {
+        if hash[i] != target[i] {
+            return hash[i] < target[i];
+        }
+    }
+    true
+}
+
+fn mine_thread(
+    index: u32,
+    threads: u32,
+    current: Arc<Mutex<Option<Arc<Job>>>>,
+    generation: Arc<AtomicU64>,
+    stop: Arc<AtomicBool>,
+    work_done: Arc<AtomicU64>,
+    found: async_channel::Sender<Found>,
+) {
+    while !stop.load(Ordering::Relaxed) {
+        let gen = generation.load(Ordering::Acquire);
+        let Some(job) = current.lock().unwrap().clone() else {
+            std::thread::sleep(Duration::from_millis(20));
+            continue;
+        };
+        let mut nonce = index;
+        while !stop.load(Ordering::Relaxed) && generation.load(Ordering::Acquire) == gen {
+            let header = job.header(nonce);
+            let hit = match &job.useful {
+                Some((work, batch_root)) => {
+                    let sigma = aperture_pouw::seed(&header, batch_root);
+                    let (hit, tickets) = work.search(&sigma, &job.target_le);
+                    work_done.fetch_add(tickets, Ordering::Relaxed);
+                    hit.map(|h| {
+                        (
+                            h.pow,
+                            Some(ShareTicket {
+                                ticket: h.ticket,
+                                panel: h.panel,
+                            }),
+                        )
+                    })
+                }
+                None => {
+                    work_done.fetch_add(1, Ordering::Relaxed);
+                    let pow = aperture_pow::pow_hash(&header);
+                    meets(&pow, &job.target_le).then_some((pow, None))
+                }
+            };
+            if let Some((pow, ticket)) = hit {
+                let _ = found.send_blocking(Found {
+                    job: job.clone(),
+                    nonce,
+                    pow,
+                    ticket,
+                });
+            }
+            nonce = nonce.wrapping_add(threads);
+            if nonce < threads {
+                break; // nonce space exhausted for this job; wait for new work
+            }
+        }
+        while !stop.load(Ordering::Relaxed) && generation.load(Ordering::Acquire) == gen {
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
+}
+
+fn benchmark(model: &Arc<Model>, rank: u32, threads: usize) -> f32 {
+    let Ok(work) = Work::new(model.clone(), &[], rank) else {
+        return 1000.0;
+    };
+    let never = [0u8; 32];
+    let start = Instant::now();
+    let mut tickets = 0u64;
+    let mut sigma = [0u8; 32];
+    while start.elapsed() < Duration::from_millis(500) {
+        sigma[0] = sigma[0].wrapping_add(1);
+        tickets += work.search(&sigma, &never).1;
+    }
+    (tickets as f64 / start.elapsed().as_secs_f64() * threads as f64) as f32
+}
+
+fn frame_of(msg: AnyMessageOwned) -> OutboundFrame {
+    OutboundFrame::from_message(msg).expect("message frames")
+}
+
+/// A standard share with the v2 ticket TLV appended (raw frame).
+fn share_frame(share: SubmitSharesStandardOwned, ticket: Option<&ShareTicket>) -> OutboundFrame {
+    let frame = frame_of(AnyMessageOwned::Mining(MiningOwned::SubmitSharesStandard(
+        share,
+    )));
+    let Some(ticket) = ticket else { return frame };
+    let mut bytes = vec![0u8; frame.encoded_length()];
+    frame.encode_into(&mut bytes).expect("encode share");
+    wire::append_to_frame(&mut bytes, &ticket.to_tlv());
+    OutboundFrame::Raw(SerializedFrame::from_bytes(bytes.into()).expect("valid frame"))
+}
+
+#[tokio::main]
+async fn main() {
+    let args = match parse_args() {
+        Ok(a) => a,
+        Err(e) => {
+            eprintln!("error: {e}");
+            std::process::exit(2);
+        }
+    };
+    if let Err(e) = run(args).await {
+        eprintln!("error: {e}");
+        std::process::exit(1);
+    }
+}
+
+async fn run(args: Args) -> Result<(), String> {
+    let model = match (&args.model_path, args.tiny_seed) {
+        (Some(p), _) => Model::load_file(p)?,
+        (None, Some(seed)) => Model::tiny(seed)?,
+        _ => unreachable!(),
+    };
+    println!(
+        "protocol model {} ({} weight matmuls), {} kernels, {} threads",
+        hex(&model.model_id()),
+        model.num_ops(),
+        aperture_pouw::backend_name(),
+        args.threads
+    );
+    let hashrate = match args.hashrate {
+        Some(h) => h,
+        None => benchmark(&model, args.rank, args.threads),
+    };
+    println!("nominal hashrate {hashrate:.0} tickets/s");
+
+    let addr = args
+        .pool
+        .to_socket_addrs()
+        .map_err(|e| format!("{}: {e}", args.pool))?
+        .next()
+        .ok_or("pool address does not resolve")?;
+    let key = match &args.pool_key {
+        Some(k) => Some(
+            Secp256k1PublicKey::try_from(k.clone())
+                .map_err(|e| format!("--pool-key: {e:?}"))?
+                .0,
+        ),
+        None => None,
+    };
+    let stream = TcpStream::connect(addr)
+        .await
+        .map_err(|e| format!("connect {addr}: {e}"))?;
+    let (receiver, sender) =
+        Connection::connect::<OutboundFrame>(stream, Initiator::new(key), CancellationToken::new())
+            .await
+            .map_err(|e| format!("noise handshake: {e:?}"))?;
+    println!("connected to {addr}");
+
+    let send = |f: OutboundFrame| {
+        let sender = sender.clone();
+        async move { sender.send(f).await.map_err(|e| format!("send: {e}")) }
+    };
+    send(frame_of(AnyMessageOwned::Common(
+        CommonMessagesOwned::SetupConnection(SetupConnectionOwned {
+            protocol: Protocol::MiningProtocol,
+            min_version: 2,
+            max_version: 2,
+            flags: 0b001, // REQUIRES_STANDARD_JOBS
+            endpoint_host: addr.ip().to_string().try_into().unwrap(),
+            endpoint_port: addr.port(),
+            vendor: "ApertureCoin".to_string().try_into().unwrap(),
+            hardware_version: "aperture-pouw-miner".to_string().try_into().unwrap(),
+            firmware: env!("CARGO_PKG_VERSION").to_string().try_into().unwrap(),
+            device_id: "".to_string().try_into().unwrap(),
+        }),
+    )))
+    .await?;
+
+    let current: Arc<Mutex<Option<Arc<Job>>>> = Arc::new(Mutex::new(None));
+    let generation = Arc::new(AtomicU64::new(0));
+    let stop = Arc::new(AtomicBool::new(false));
+    let work_done = Arc::new(AtomicU64::new(0));
+    let (found_tx, found_rx) = async_channel::unbounded::<Found>();
+    for i in 0..args.threads {
+        let (c, g, s, w, f) = (
+            current.clone(),
+            generation.clone(),
+            stop.clone(),
+            work_done.clone(),
+            found_tx.clone(),
+        );
+        let n = args.threads as u32;
+        std::thread::spawn(move || mine_thread(i as u32, n, c, g, s, w, f));
+    }
+
+    let mut channel_id: Option<u32> = None;
+    let mut target_le = [0xffu8; 32];
+    let mut prev: Option<([u8; 32], u32, u32, u32)> = None; // prev_hash, nbits, min_ntime, job_id
+    let mut jobs: HashMap<u32, (u32, [u8; 32], Option<u32>)> = HashMap::new(); // job_id -> version, merkle_root, min_ntime
+    let mut job_work: HashMap<u32, (Arc<Work>, [u8; 32])> = HashMap::new();
+    let mut work_cache: HashMap<([u8; 32], u8), Arc<Work>> = HashMap::new();
+    let mut active_job: Option<u32> = None;
+    let mut sequence = 0u32;
+    let mut accepted = 0u64;
+    let mut rejected = 0u64;
+    let started = Instant::now();
+
+    let activate = |job_id: u32,
+                    jobs: &HashMap<u32, (u32, [u8; 32], Option<u32>)>,
+                    job_work: &HashMap<u32, (Arc<Work>, [u8; 32])>,
+                    prev: &Option<([u8; 32], u32, u32, u32)>,
+                    channel_id: Option<u32>,
+                    target_le: [u8; 32]| {
+        let (
+            Some((version, merkle_root, min_ntime)),
+            Some((prev_hash, nbits, prev_ntime, _)),
+            Some(channel_id),
+        ) = (jobs.get(&job_id), prev.as_ref(), channel_id)
+        else {
+            return false;
+        };
+        let useful = job_work.get(&job_id).cloned();
+        if version & aperture_pouw::VERSION_POWV2 != 0 && useful.is_none() {
+            println!("v2 job {job_id} without useful work: not mining it");
+            *current.lock().unwrap() = None;
+            generation.fetch_add(1, Ordering::Release);
+            return false;
+        }
+        *current.lock().unwrap() = Some(Arc::new(Job {
+            channel_id,
+            job_id,
+            version: *version,
+            prev_hash: *prev_hash,
+            merkle_root: *merkle_root,
+            nbits: *nbits,
+            ntime: min_ntime.unwrap_or(*prev_ntime).max(*prev_ntime),
+            target_le,
+            useful,
+        }));
+        generation.fetch_add(1, Ordering::Release);
+        true
+    };
+
+    let mut pending: HashMap<u32, Found> = HashMap::new();
+    loop {
+        tokio::select! {
+            found = found_rx.recv() => {
+                let Ok(f) = found else { break };
+                if Some(f.job.job_id) != active_job { continue; }
+                let mut ticket = f.ticket.clone();
+                if args.corrupt_panels {
+                    // Test hook: a panel that is not the forward pass's activations.
+                    if let Some(t) = ticket.as_mut() { t.panel[0] = if t.panel[0] == 1 { 2 } else { 1 }; }
+                }
+                sequence += 1;
+                let share = SubmitSharesStandardOwned {
+                    channel_id: f.job.channel_id,
+                    sequence_number: sequence,
+                    job_id: f.job.job_id,
+                    nonce: f.nonce,
+                    ntime: f.job.ntime,
+                    version: f.job.version,
+                };
+                let t = f.ticket.as_ref().map(|t| format!("{},{},{},{}", t.ticket.op, t.ticket.i, t.ticket.j, t.ticket.s)).unwrap_or_else(|| "-".into());
+                println!("share job={} nonce={} ticket={} pow={} header={}", f.job.job_id, f.nonce, t, hex(&f.pow), hex(&f.job.header(f.nonce)));
+                send(share_frame(share, ticket.as_ref())).await?;
+                pending.insert(sequence, f);
+            }
+            frame = receiver.recv() => {
+                let Ok(mut frame) = frame else { return Err("pool closed the connection".into()) };
+                let header = frame.header();
+                if header.ext_type_without_channel_msg() == wire::EXTENSION_TYPE {
+                    if header.msg_type() == wire::MSG_SET_USEFUL_WORK {
+                        let (_, job_id, uw) = wire::decode_set_useful_work(frame.payload())?;
+                        let work = useful_work(&model, &uw, &mut work_cache).await?;
+                        job_work.insert(job_id, (work, uw.batch_root));
+                    }
+                    continue;
+                }
+                let negotiated = [wire::EXTENSION_TYPE];
+                let (msg, _) = parse_message_frame_with_tlvs(header, frame.payload(), &negotiated).map_err(|e| format!("parse: {e:?}"))?;
+                match msg.into_owned() {
+                    AnyMessageOwned::Common(CommonMessagesOwned::SetupConnectionSuccess(_)) => {
+                        send(frame_of(AnyMessageOwned::Extensions(ExtensionsOwned::ExtensionsNegotiation(
+                            ExtensionsNegotiationOwned::RequestExtensions(RequestExtensionsOwned {
+                                request_id: 1,
+                                requested_extensions: Seq064KOwned::new(vec![wire::EXTENSION_TYPE]).unwrap(),
+                            }),
+                        ))))
+                        .await?;
+                    }
+                    AnyMessageOwned::Common(CommonMessagesOwned::SetupConnectionError(e)) => {
+                        return Err(format!("SetupConnection rejected: {e}"));
+                    }
+                    AnyMessageOwned::Extensions(ExtensionsOwned::ExtensionsNegotiation(m)) => match m {
+                        ExtensionsNegotiationOwned::RequestExtensionsSuccess(_) => {
+                            println!("extension 0x{:04x} negotiated", wire::EXTENSION_TYPE);
+                            send(frame_of(AnyMessageOwned::Mining(MiningOwned::OpenStandardMiningChannel(OpenStandardMiningChannelOwned {
+                                request_id: 1,
+                                user_identity: args.user.clone().try_into().unwrap(),
+                                nominal_hash_rate: hashrate,
+                                max_target: vec![0xffu8; 32].try_into().unwrap(),
+                            }))))
+                            .await?;
+                        }
+                        other => return Err(format!("the pool does not support useful work (0x4150): {other:?}")),
+                    },
+                    AnyMessageOwned::Mining(m) => match m {
+                        MiningOwned::OpenStandardMiningChannelSuccess(m) => {
+                            channel_id = Some(m.channel_id);
+                            target_le.copy_from_slice(m.target.as_ref());
+                            println!("channel {} open, target {}", m.channel_id, hex(&target_le.iter().rev().copied().collect::<Vec<_>>()));
+                        }
+                        MiningOwned::OpenMiningChannelError(e) => return Err(format!("OpenStandardMiningChannel rejected: {e}")),
+                        MiningOwned::SetTarget(m) => {
+                            target_le.copy_from_slice(m.maximum_target.as_ref());
+                            if let Some(id) = active_job {
+                                activate(id, &jobs, &job_work, &prev, channel_id, target_le);
+                            }
+                        }
+                        MiningOwned::NewMiningJob(m) => {
+                            let min_ntime = m.min_ntime.clone().into_inner();
+                            let mut root = [0u8; 32];
+                            root.copy_from_slice(m.merkle_root.as_ref());
+                            jobs.insert(m.job_id, (m.version, root, min_ntime));
+                            let kind = if m.version & aperture_pouw::VERSION_POWV2 != 0 { "v2" } else { "v1" };
+                            println!("job {} ({kind}{})", m.job_id, if min_ntime.is_none() { ", future" } else { "" });
+                            if min_ntime.is_some() && activate(m.job_id, &jobs, &job_work, &prev, channel_id, target_le) {
+                                active_job = Some(m.job_id);
+                            }
+                        }
+                        MiningOwned::SetNewPrevHash(m) => {
+                            let mut p = [0u8; 32];
+                            p.copy_from_slice(m.prev_hash.as_ref());
+                            prev = Some((p, m.nbits, m.min_ntime, m.job_id));
+                            if activate(m.job_id, &jobs, &job_work, &prev, channel_id, target_le) {
+                                active_job = Some(m.job_id);
+                            }
+                            // Older jobs are stale now.
+                            jobs.retain(|id, _| *id >= m.job_id);
+                            job_work.retain(|id, _| *id >= m.job_id);
+                        }
+                        MiningOwned::SubmitSharesSuccess(m) => {
+                            let n = m.new_submits_accepted_count as u64;
+                            accepted += n;
+                            let last = m.last_sequence_number;
+                            let mut acked: Vec<u32> = pending.keys().copied().filter(|s| *s <= last).collect();
+                            acked.sort();
+                            for s in acked {
+                                if let Some(f) = pending.remove(&s) {
+                                    println!("accepted seq={s} job={} pow={}", f.job.job_id, hex(&f.pow));
+                                }
+                            }
+                            let secs = started.elapsed().as_secs_f64();
+                            println!("shares {accepted} accepted / {rejected} rejected, {:.0} tickets/s", work_done.load(Ordering::Relaxed) as f64 / secs);
+                            if args.shares.is_some_and(|s| accepted >= s) {
+                                stop.store(true, Ordering::Relaxed);
+                                return Ok(());
+                            }
+                        }
+                        MiningOwned::SubmitSharesError(m) => {
+                            rejected += 1;
+                            pending.remove(&m.sequence_number);
+                            println!("rejected seq={} {}", m.sequence_number, String::from_utf8_lossy(m.error_code.as_ref()));
+                        }
+                        MiningOwned::CloseChannel(m) => return Err(format!("channel closed by the pool: {m}")),
+                        _ => {}
+                    },
+                    _ => {}
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Forward pass over a job's batch, cached by batch_root and rank.
+async fn useful_work(
+    model: &Arc<Model>,
+    uw: &UsefulWork,
+    cache: &mut HashMap<([u8; 32], u8), Arc<Work>>,
+) -> Result<Arc<Work>, String> {
+    if uw.model_id != model.model_id() {
+        return Err(format!(
+            "the pool's model {} differs from ours {}",
+            hex(&uw.model_id),
+            hex(&model.model_id())
+        ));
+    }
+    if let Some(w) = cache.get(&(uw.batch_root, uw.rank)) {
+        return Ok(w.clone());
+    }
+    let (m, requests, rank) = (model.clone(), uw.requests.clone(), uw.rank as u32);
+    let started = Instant::now();
+    let work = tokio::task::spawn_blocking(move || Work::new(m, &requests, rank))
+        .await
+        .map_err(|e| e.to_string())??;
+    println!(
+        "useful work: {} embedding requests, forward pass {:.1} ms, rank {}",
+        uw.requests.len(),
+        started.elapsed().as_secs_f64() * 1e3,
+        uw.rank
+    );
+    if cache.len() > 16 {
+        cache.clear();
+    }
+    cache.insert((uw.batch_root, uw.rank), work.clone());
+    Ok(work)
+}
