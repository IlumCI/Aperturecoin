+//! ApertureCoin address decoding for `addr()` descriptors and payout identities.
+//!
+//! ApertureCoin (ticker SCIENCE) keeps Bitcoin's script templates but uses its own
+//! address encodings (ApertureCoin `src/chainparams.cpp`):
+//!
+//! | network | bech32/bech32m HRP | base58 P2PKH | base58 P2SH |
+//! |---------|--------------------|--------------|-------------|
+//! | main    | `sci`              | 23 (`A`)     | 83 (`a`)    |
+//! | test    | `tsci`             | 111          | 196, 58     |
+//! | regtest | `rsci`             | 111          | 196, 58     |
+
+use miniscript::bitcoin::{
+    PubkeyHash, ScriptBuf, ScriptHash, WitnessProgram, WitnessVersion, base58,
+    bech32::{self, Hrp},
+    hashes::Hash,
+};
+
+/// Decoded ApertureCoin address: its script and whether it is a mainnet address.
+pub(super) fn decode(address: &str) -> Option<(ScriptBuf, bool)> {
+    if let Ok((hrp, version, program)) = bech32::segwit::decode(address) {
+        let mainnet = if hrp == Hrp::parse_unchecked("sci") {
+            true
+        } else if hrp == Hrp::parse_unchecked("tsci") || hrp == Hrp::parse_unchecked("rsci") {
+            false
+        } else {
+            return None;
+        };
+        let version = WitnessVersion::try_from(version).ok()?;
+        let wp = WitnessProgram::new(version, &program).ok()?;
+        return Some((ScriptBuf::new_witness_program(&wp), mainnet));
+    }
+    let data = base58::decode_check(address).ok()?;
+    if data.len() != 21 {
+        return None;
+    }
+    let hash: [u8; 20] = data[1..].try_into().ok()?;
+    match data[0] {
+        23 => Some((
+            ScriptBuf::new_p2pkh(&PubkeyHash::from_byte_array(hash)),
+            true,
+        )),
+        83 => Some((
+            ScriptBuf::new_p2sh(&ScriptHash::from_byte_array(hash)),
+            true,
+        )),
+        111 => Some((
+            ScriptBuf::new_p2pkh(&PubkeyHash::from_byte_array(hash)),
+            false,
+        )),
+        196 | 58 => Some((
+            ScriptBuf::new_p2sh(&ScriptHash::from_byte_array(hash)),
+            false,
+        )),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use miniscript::bitcoin::bech32::{Fe32, segwit};
+
+    #[test]
+    fn bech32_networks() {
+        let prog = [7u8; 20];
+        for (hrp, mainnet) in [("sci", true), ("tsci", false), ("rsci", false)] {
+            let a = segwit::encode(Hrp::parse(hrp).unwrap(), Fe32::Q, &prog).unwrap();
+            let (script, m) = decode(&a).unwrap();
+            assert_eq!(m, mainnet);
+            assert_eq!(script.as_bytes()[..2], [0x00, 0x14]);
+            assert_eq!(&script.as_bytes()[2..], &prog);
+        }
+        let tr = segwit::encode(Hrp::parse("rsci").unwrap(), Fe32::P, &[9u8; 32]).unwrap();
+        assert_eq!(decode(&tr).unwrap().0.as_bytes()[..2], [0x51, 0x20]);
+        let btc = segwit::encode(Hrp::parse("bc").unwrap(), Fe32::Q, &prog).unwrap();
+        assert!(decode(&btc).is_none());
+    }
+
+    #[test]
+    fn base58_prefixes() {
+        let mut d = vec![23u8];
+        d.extend([1u8; 20]);
+        let a = base58::encode_check(&d);
+        assert!(a.starts_with('A'));
+        let (s, m) = decode(&a).unwrap();
+        assert!(m && s.is_p2pkh());
+        d[0] = 83;
+        let (s, m) = decode(&base58::encode_check(&d)).unwrap();
+        assert!(m && s.is_p2sh());
+        d[0] = 0; // Bitcoin mainnet P2PKH is not an ApertureCoin address
+        assert!(decode(&base58::encode_check(&d)).is_none());
+    }
+}
+
+#[cfg(test)]
+mod descriptor_tests {
+    #[test]
+    fn addr_descriptor() {
+        let r = super::super::CoinbaseRewardScript::from_descriptor(
+            "addr(rsci1qcgf339mlm56vug5vhumv80xynrkz2reknurua5)",
+        );
+        println!("{r:?}");
+        assert!(r.is_ok());
+    }
+}
